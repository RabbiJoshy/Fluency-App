{
  "config_version": "harvest-language-policy/v1",
  "policy_id": "es-v1",
  "language": "es",
  "normalization": {
    "unicode_form": "NFC",
    "casefold": true,
    "canonical_apostrophe": "'",
    "apostrophe_variants": [
      "’",
      "‘",
      "ʼ",
      "‛",
      "＇"
    ],
    "collapse_whitespace": true
  },
  "matching": {
    "boundary_policy": "unicode_word",
    "token_pattern": "[^\\W\\d_]+(?:['’-][^\\W\\d_]+)*"
  },
  "sentence_rules": {
    "reject_contains_apostrophe": false,
    "reject_contains_hyphen": false,
    "require_inverted_punctuation": true,
    "forbidden_substrings": [
      "http://",
      "https://",
      "<",
      ">",
      "♪",
      "♫"
    ]
  },
  "variety_markers": {
    "419": [
      "\\b(ustedes|carro|celular|papá|mamá|allá|acá|plata|manejar|computadora)\\b"
    ],
    "es": [
      "\\b(vosotros|vosotras|coche|móvil|ordenador|vale|zumo|piso|tío|guay)\\b",
      "\\b\\w+(áis|éis|ís)\\b"
    ]
  },
  "variety_note": "Peninsular against Latin American. vosotros/ustedes is the reliable structural split; lexis is weaker because much is shared.",
  "sentence_rules_note": "require_inverted_punctuation drops any target with more '?' than '¿' or more '!' than '¡'. Spanish only: it is the cheapest reliable marker of a machine-translated subtitle track."
}
