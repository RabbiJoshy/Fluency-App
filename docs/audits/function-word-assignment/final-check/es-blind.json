{
  "patterns": {
    "de": [
      {
        "tag": "Verbs with de",
        "formulaHTML": "<span class=\"fw-token-v\">verb</span> + <span class=\"fw-token-connector\">de</span>",
        "rule": "Some verbs use de to link to what follows. Learn the verb and de together.",
        "slotTypes": {
          "v": "verb",
          "c": "mixed"
        }
      },
      {
        "tag": "Adding a detail",
        "formulaHTML": "<span class=\"fw-token-v\">noun</span> + <span class=\"fw-token-connector\">de</span>",
        "rule": "Adds a detail about ownership, contents, material or purpose, including an action: hora de comer = time to eat.",
        "slotTypes": {
          "v": "noun",
          "c": "mixed"
        }
      }
    ],
    "que": [
      {
        "tag": "Saying what you think",
        "formulaHTML": "<span class=\"fw-token-v\">think / say / know / hope</span> + <span class=\"fw-token-connector\">que</span>",
        "rule": "Links what someone thinks, says, knows or hopes to a statement.",
        "slotTypes": {
          "v": "verb",
          "c": "clause"
        }
      },
      {
        "tag": "Adding information",
        "formulaHTML": "<span class=\"fw-token-v\">noun</span> + <span class=\"fw-token-connector\">que</span>",
        "rule": "Adds information about the noun.",
        "slotTypes": {
          "v": "noun",
          "c": "clause"
        }
      },
      {
        "tag": "Comparing",
        "formulaHTML": "<span class=\"fw-token-v\">more, less or better</span> + <span class=\"fw-token-connector\">que</span>",
        "rule": "Means “than” when comparing people, things or situations.",
        "slotTypes": {
          "v": "phrase",
          "c": "phrase"
        }
      }
    ],
    "se": [
      {
        "tag": "Oneself / part of a verb",
        "formulaHTML": "<span class=\"fw-token-connector\">se</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Can mean “oneself”, or belong with a verb such as sentirse (feel). It does not always mean “oneself”.",
        "slotTypes": {
          "v": "verb"
        }
      },
      {
        "tag": "Without saying who",
        "formulaHTML": "<span class=\"fw-token-connector\">se</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Describes what happens without naming who does it. Compare se habla (people speak) and se venden libros (books are sold).",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "lo": [
      {
        "tag": "The … thing / part",
        "formulaHTML": "<span class=\"fw-token-connector\">lo</span> + <span class=\"fw-token-c\">adjective</span>",
        "rule": "With an adjective, means “the … thing” or “the … part”: lo importante = the important thing.",
        "slotTypes": {
          "c": "adj"
        }
      },
      {
        "tag": "Him / it / that",
        "formulaHTML": "<span class=\"fw-token-connector\">lo</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Refers to “him”, a masculine “it”, or an idea: lo sé = I know that.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "nos": [
      {
        "tag": "Us / to us",
        "formulaHTML": "<span class=\"fw-token-connector\">nos</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Refers to us: someone sees or helps us, or tells us something.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "al": [
      {
        "tag": "To / at the",
        "formulaHTML": "<span class=\"fw-token-connector\">al</span> + <span class=\"fw-token-c\">destination</span>",
        "rule": "Here, a + el becomes al: “to the” or “at the”.",
        "slotTypes": {
          "c": "phrase"
        }
      },
      {
        "tag": "When doing something",
        "formulaHTML": "<span class=\"fw-token-connector\">al</span> + <span class=\"fw-token-v\">infinitive (dictionary form)</span>",
        "rule": "Means “when” doing something: al llegar = when someone arrives.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "el": [
      {
        "tag": "The",
        "formulaHTML": "<span class=\"fw-token-connector\">el</span> + <span class=\"fw-token-c\">masculine singular noun</span>",
        "rule": "Means “the”. Use the form that matches the noun’s gender and number.",
        "slotTypes": {
          "c": "noun"
        }
      }
    ],
    "la": [
      {
        "tag": "The",
        "formulaHTML": "<span class=\"fw-token-connector\">la</span> + <span class=\"fw-token-c\">feminine singular noun</span>",
        "rule": "Means “the”. Use the form that matches the noun’s gender and number.",
        "slotTypes": {
          "c": "noun"
        }
      },
      {
        "tag": "Her / it",
        "formulaHTML": "<span class=\"fw-token-connector\">la</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Refers to “her / it”. The surrounding verb and sentence show who or what is meant.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "yo": [
      {
        "tag": "I",
        "formulaHTML": "<span class=\"fw-token-connector\">Yo</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Means “I”. Names who does the action; the pronoun can often be left out.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "tú": [
      {
        "tag": "you",
        "formulaHTML": "<span class=\"fw-token-connector\">Tú</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Means “you”. Names who does the action; the pronoun can often be left out.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ]
  },
