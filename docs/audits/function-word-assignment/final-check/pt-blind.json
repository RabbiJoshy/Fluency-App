  "patterns": {
    "de": [
      {
        "tag": "Verbs with de",
        "formulaHTML": "<span class=\"fw-token-v\">verb</span> + <span class=\"fw-token-connector\">de</span>",
        "rule": "Some verbs use de to link to what follows. Learn the verb and de together.",
        "slotTypes": {
          "v": "verb",
          "c": "mixed"
        }
      },
      {
        "tag": "Adding a detail",
        "formulaHTML": "<span class=\"fw-token-v\">noun</span> + <span class=\"fw-token-connector\">de</span>",
        "rule": "Adds a detail about ownership, contents, material or purpose, including an action: hora de partir = time to leave.",
        "slotTypes": {
          "v": "noun",
          "c": "mixed"
        }
      }
    ],
    "que": [
      {
        "tag": "Saying what you think",
        "formulaHTML": "<span class=\"fw-token-v\">think / say / know / hope</span> + <span class=\"fw-token-connector\">que</span>",
        "rule": "Links what someone thinks, says, knows or hopes to a statement.",
        "slotTypes": {
          "v": "verb",
          "c": "clause"
        }
      },
      {
        "tag": "Adding information",
        "formulaHTML": "<span class=\"fw-token-v\">noun</span> + <span class=\"fw-token-connector\">que</span>",
        "rule": "Adds information about the noun.",
        "slotTypes": {
          "v": "noun",
          "c": "clause"
        }
      },
      {
        "tag": "Comparing",
        "formulaHTML": "<span class=\"fw-token-v\">more, less or better</span> + <span class=\"fw-token-connector\">que</span>",
        "rule": "Means “than” when comparing people, things or situations.",
        "slotTypes": {
          "v": "phrase",
          "c": "phrase"
        }
      }
    ],
    "se": [
      {
        "tag": "If",
        "formulaHTML": "<span class=\"fw-token-connector\">se</span> + <span class=\"fw-token-v\">a possible situation</span> + <span class=\"fw-token-c\">what happens then</span>",
        "rule": "Means “if”: gives a possible situation and what happens then.",
        "slotTypes": {
          "v": "clause",
          "c": "clause"
        }
      },
      {
        "tag": "Oneself / part of a verb",
        "formulaHTML": "<span class=\"fw-token-connector\">se</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Can mean “oneself”, or belong with a verb such as sentir-se (feel). It does not always mean “oneself”.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "o": [
      {
        "tag": "The",
        "formulaHTML": "<span class=\"fw-token-connector\">o</span> + <span class=\"fw-token-c\">masculine singular noun</span>",
        "rule": "Means “the” before a masculine singular noun, such as livro (book).",
        "slotTypes": {
          "c": "noun"
        }
      },
      {
        "tag": "Him / it",
        "formulaHTML": "<span class=\"fw-token-connector\">o</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Refers to “him” or a masculine “it”. These examples place o before the verb; other positions also occur.",
        "slotTypes": {
          "v": "verb"
        }
      }
    ],
    "nos": [
      {
        "tag": "Us / to us",
        "formulaHTML": "<span class=\"fw-token-connector\">nos</span> + <span class=\"fw-token-v\">verb</span>",
        "rule": "Refers to us: someone sees or helps us, or tells us something.",
        "slotTypes": {
          "v": "verb"
        }
      },
      {
        "tag": "In / on / at the",
        "formulaHTML": "<span class=\"fw-token-connector\">nos</span> + <span class=\"fw-token-c\">masculine plural noun</span>",
        "rule": "Combines em + os: “in”, “on” or “at the”, before a masculine plural noun.",
