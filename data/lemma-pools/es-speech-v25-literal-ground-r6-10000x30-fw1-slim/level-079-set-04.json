3365:710:1449751","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5090828","6693365","710"],"w":["leaf",1]},{"t":"Me sostiene el brazo. ¿De qué habla?","e":"You got my arm right there. What are you talking about?","s":"opensubtitles","x":"763e35a72f6f51412d97af755213c1b9","i":"e99ac112ef9b64369e2d21ccca1ba78b","r":"1620935:6889569:853:48579","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1620935","6889569","853"],"w":["leaf",1]},{"t":"Tom sostiene que puede leer la mente.","e":"Tom claims that he can read people's minds.","s":"tatoeba","x":"5a020213268746fc83954a6c576f2d9c","i":"2741c13783f78213af8377e0cc943053","r":"1313047:1095271","c":"marcelostockle","su":"https://tatoeba.org/en/sentences/show/1313047","ul":"https://tatoeba.org/en/sentences/show/1313047","b":"Tatoeba sentence #1313047 by marcelostockle; English translation #1095271 by CK","o":"https://tatoeba.org/en/sentences/show/1313047","tu":1,"w":["leaf",1]},{"t":"Lo dicen las fotografías que sostiene.","e":"Says the photographs you're holding.","s":"opensubtitles","x":"41775a5cf1a6caeae4aac13e3d815f39","i":"a96626cb8122949de1269aeb6520be07","r":"6343002:6871015:297:3955262","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6343002","6871015","297"],"w":["leaf",1]},{"t":"¿También te sostiene la cartera?","e":"I mean, he gonna hold your purse, too?","s":"opensubtitles","x":"33e7e131868bccf4fcad440dde80ac00","i":"1feb7627c094f37d86f64746cb8f32c6","r":"4179628:6754688:251:526832","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4179628","6754688","251"],"w":["glosskey",0]},{"t":"Uno simplemente sostiene las piernas.","e":"You just hold the legs.","s":"opensubtitles","x":"dfa9eed86109e75952cef2c30228e4f3","i":"210f925b6bcb2fbc8b3e47f0a5b5c2dc","r":"4007248:6765935:842:467777","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4007248","6765935","842"],"w":["leaf",1]},{"t":"Sostiene al águila con fuerza.","e":"She holds the eagle with strength.","s":"opensubtitles","x":"03d