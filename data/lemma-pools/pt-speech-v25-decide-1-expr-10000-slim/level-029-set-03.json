4555,"version":"labse-cosine/v1"},"x":"8932f818f8bc1adca7ddd0ec16075713","i":"45cf70a6c88e30a859a768bc7bddf6f3","r":"3807532:6618044:808:591894","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3807532","6618044","808"],"w":["leaf",0]},{"t":"O que significa que vou ter que usar O Macaco das Tarefas de Ouro.","e":"Which means I'll have to use Choremonkey Gold.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.778529,"version":"labse-cosine/v1"},"x":"35bc1a4241ee4227929a81020f57dd4b","i":"73a4adb09ef779677b1fbc73977f1f3e","r":"4765710:6832467:101:2940031","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4765710","6832467","101"],"w":["leaf",0]},{"t":"Talvez estejam muito ocupadas e a fazer múltiplas tarefas.","e":"Maybe they're very busy, and they're multitasking.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.818242,"version":"labse-cosine/v1"},"x":"bf07aa3e8a65e74c287966cc2fdf0263","i":"04a727bf40fe9a155534869e90a56a57","r":"4964764:6662840:455:3134265","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4964764","6662840","455"],"w":["leaf",0]},{"t":"Que as minhas tarefas me completem como eu as completo.","e":"May my chores complete me as I complete them.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.867387,"version":"labse-cosine/v1"},"x":"656a021a782204ecee629779ac8723f7","i":"bd1e00dfb98de72bdce7863660ff48e1","r":"4832266:6790507:316:1924664","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4832266","6790507","316"],"w":["leaf",0]}],[]]},"6de21c54":{"m":[[],[{"t":"Como é que você pode ser tão cega?","e":"How can you be so blind?","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.879722,"version":"labse-cosine/v1"},"x":"56cb5bee13c93c55c937a793372a39d4","i":"075f77fa1021386ca99d29f4c03aedf9","r":"5034304:2891372","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/5034304","ul":"https://tatoeba.org/en/sentences/show/5034304",