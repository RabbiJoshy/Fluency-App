les-v2018.php","d":["6118106","6972518","66"],"w":["leaf",0]},{"t":"E estou envergonhada que o residente em questão seja o meu marido!","e":"And I'm embarrassed that the resident in question happens to be my husband!","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.912161,"version":"labse-cosine/v1"},"x":"4c3943c53d11edf82ced164ee3c86c98","i":"738cdabefd30b93d8965b8e1f4553dfa","r":"5505500:6567887:1027:3747739","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5505500","6567887","1027"],"w":["leaf",0]},{"t":"Acho que ela ainda ficaria mais envergonhada se tivesse que cancelar os eventos.","e":"My guess is she'd be even more embarrassed if she had to cancel her events.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.835907,"version":"labse-cosine/v1"},"x":"eab74741a071e94aa71fbb0546a22c82","i":"aeaaf376a5d744319630e5fd8abce4d6","r":"4128572:6314869:805:945928","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4128572","6314869","805"],"w":["leaf",0]},{"t":"Mesmo envergonhada em todo o lado, sou livre.","e":"Though encumbered everywhere, I am free.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.824945,"version":"labse-cosine/v1"},"x":"05059dd3e6f3613b261d32d2a0df2196","i":"e3f16aaa849aace6bd208c0e951fd8e3","r":"5003004:6547946:279:3157292","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5003004","6547946","279"],"w":["leaf",0]},{"t":"Não quero que fique envergonhada quando perceber quão enganada está.","e":"I just... I don't want you to be embarrassed when you realize how wrong you are.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.787905,"version":"labse-cosine/v1"},"x":"1c09e181b88bf2dbd5f5c3b32dcd3626","i":"f03e42408d772ec858797c5d41d32f5d","r":"4955286:6452600:173:3128108","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4955286","6452600","173"],"w":["leaf",0]},{"t":"Estou tão envergonhada que não te consigo contar.","e":"I'm so embarrassed, I can't tell you.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.845547,"version":"labse-cosine/v1"},"x":"80c4602e22aab22f990bd1de98399a13","i":"f9fa61dbf205ab8d4b770b033c44d3e4","r":"3500544:6838278:993:389350","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3500544","6838278","993"],"w":["leaf",0]},{"t":"Não quero falar contigo porque me sinto envergonhada sempre que penso no que aconteceu.","e":"I don't wanna talk to you, because I feel embarrassed. Every time I think about what happened.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.836981,"version":"labse-cosine/v1"},"x":"58b2bbedbe4ea94d7e22e68710478e10","i":"9db6eba8625a2c1c5e9f4d0a122ae80f","r":"4652838:6824422:931:1795701","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4652838","6824422","931"],"w":["leaf",0]},{"t":"Admita que estou envergonhada e sem um tostão, que não tenho perspectiva ou esperança?","e":"Admit that I am shamed and penniless, that I have no prospect and no hope.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.814256,"version":"labse-cosine/v1"},"x":"eb0118da6570b01381e7c9b578031f84","i":"17d55ce049852705f4751eb136e53560","r":"4114238:6066356:345:902951","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4114238","6066356","345"],"w":["leaf",0]},{"t":"Mary estava envergonhada e pediu desculpas por seus erros.","e":"Mary was ashamed and apologised for her mistakes.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.896262,"version":"labse-cosine/v1"},"x":"ce9bd1d930898216a1b4706bc3bde6f6","i":"a30a80fd226437b6e90db6f9ae5da4fe","r":"6692015:3962495","c":"Mecamute","su":"https://tatoeba.org/en/sentences/show/6692015","ul":"https://tatoeba.org/en/sentences/show/6692015","b":"Tatoeba sentence #6692015 by Mecamute; English translation #3962495 by janms","o":"https://tatoeba.org/en/sentences/show/6692015","tu":1,"w":["leaf",0]}],[{"t":"Ela está envergonhada em pedir, mas é perigoso o que ela está a fazer.","e":"She is shy to ask, but... it's dangerous what she's doing.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.864962,"version":"labse-cosine/v1"},"x":"ceae2eae1d349270f64910d84b2952f1","i":"92548cb6b608d9266135be71756c460f","r":"6263012:7013686:214:5012151","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6263012","7013686","214"],"w":["leaf",0]}],[]]},"822d86e3":{"m":[[{"t":"Depois da minha lesão não via um futuro.","e":"After my injury, I couldn't see the future.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.880496,"version":"labse-cosine/v1"},"x":"d86535cc4367e005bbd5ab5733aa9a51","i":"1468fa9037f940882cb7257c128d444a","r":"4666726:7048785:1472:2852281","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4666726","7048785","1472"],"w":["leaf",0]},{"t":"O meu paciente teve uma grave lesão hoje.","e":"My patient today had a terrible injury.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.91098,"version":"labse-cosine/v1"},"x":"19a6a55e119e124b77965302cd49e7c2","i":"1f89c83e76af6ad280527c3a9efebfd8","r":"4516146:6115613:773:1628482","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4516146","6115613","773"],"w":["leaf",0]},{"t":"Não é o tamanho da lesão, mas o ângulo.","e":"It's not the size of the wound, it's the angle.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.836157,"version":"labse-cosine/v1"},"x":"c38eaa3661c47d366b1055cda545f6b3","i":"77a01834ccf3594cf5f520b8a050f939","r":"4991088:6353199:677:2058511","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4991088","6353199","677"],"w":["leaf",0]},{"t":"A lesão é grave o suficiente para causar a morte.","e":"The injury is severe enough to be cause of death.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.90948,"version":"labse-cosine/v1"},"x":"b23d549266c6adcd4d6eadcfd54fd506","i":"8e24d188b30e