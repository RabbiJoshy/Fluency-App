:201:2595700","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4168588","6950569","201"],"w":["leaf",0]},{"t":"Detonar balões que deviam estar cheios de um gás mortal na ventilação.","e":"Detonate balloons that are supposedly full of deadly gas into the air vents.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.824089,"version":"labse-cosine/v1"},"x":"fa56d6e393dcfa89e37143c57d6659f1","i":"c783e0c87bd2eb5ee5e607b756844618","r":"6365118:6940702:140:5079905","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6365118","6940702","140"],"w":["leaf",0]},{"t":"Após encher os balões, poderia varrer a sala?","e":"After you blow up those balloons, could you sweep the room?","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.859347,"version":"labse-cosine/v1"},"x":"55ec0ecaa0711152784ee8c923979b3d","i":"58e61865d11c45e0240f4a7c06da632f","r":"2462883:1165304","c":"MarlonX19","su":"https://tatoeba.org/en/sentences/show/2462883","ul":"https://tatoeba.org/en/sentences/show/2462883","b":"Tatoeba sentence #2462883 by MarlonX19; English translation #1165304 by CM","o":"https://tatoeba.org/en/sentences/show/2462883","tu":1,"w":["leaf",0]},{"t":"- Está bem, engenharia decente, mas e os grandes balões?","e":"Okay, decent engineering, but where do we get the big balloons?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.831989,"version":"labse-cosine/v1"},"x":"447f154c17d4f32dfa6e6e9a03e2f643","i":"2ac22bb25de6bec316fdea172e560f61","r":"5223032:6440097:87:2199536","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5223032","6440097","87"],"w":["leaf",0]},{"t":"À porta da escola, nas caças aos ovos e nas bênçãos de balões.","e":"At school pickups, Easter egg hunts, and blimp christenings.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.714827,"version":"labse-cosine/v1"},"x":"d62ec21f37e0ca12c337b68f2a28fdf3","i":"ca3b248d06f0a2acaa85841c586a1cc1","r":"6412826:6986116:277:5