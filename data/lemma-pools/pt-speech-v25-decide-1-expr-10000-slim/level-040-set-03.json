":"sentence-transformers/LaBSE","score":0.919678,"version":"labse-cosine/v1"},"x":"6a8c5a53e7f215bf6a99768453928a44","i":"87c74a4120ff1bf620a3d911af7056b4","r":"10830409:10830405","c":"megamanenm","su":"https://tatoeba.org/en/sentences/show/10830409","ul":"https://tatoeba.org/en/sentences/show/10830409","b":"Tatoeba sentence #10830409 by megamanenm; English translation #10830405 by megamanenm","o":"https://tatoeba.org/en/sentences/show/10830409","tu":1,"w":["leaf",0]},{"t":"Tem cancro do pulmão e está muito avançado.","e":"She has lung cancer and it's very advanced.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.903909,"version":"labse-cosine/v1"},"x":"ed3be30b72aad940d0627e904f31e9c3","i":"94d7454b9bf742c57f42fe457d2db8a2","r":"3783560:6946348:429:572461","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3783560","6946348","429"],"w":["leaf",0]},{"t":"Vamos precisar do tipo a quem o pulmão está a falhar para traduzir.","e":"We'll need the guy with the failing lung to translate.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.783195,"version":"labse-cosine/v1"},"x":"de0d939a50ce4fc2d7665f2fd10a0ff2","i":"f465030f3d46dfd2c29c817a8f2058b3","r":"5506368:6613188:526:3751763","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5506368","6613188","526"],"w":["leaf",0]},{"t":"A tosse é um dos primeiros sintomas do cancro do pulmão.","e":"A cough is one of lung cancer's first symptoms.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.917276,"version":"labse-cosine/v1"},"x":"ac14095b95395d673f2b43065980e1f7","i":"3396d65dc5ab988152a799e02ed9edf2","r":"12302524:12302523","c":"Cangarejo","su":"https://tatoeba.org/en/sentences/show/12302524","ul":"https://tatoeba.org/en/sentences/show/12302524","b":"Tatoeba sentence #12302524 by Cangarejo; English translation #12302523 by Cangarejo","o":"https://tatoeba.org/en/sentences/show/12302524","tu":1,"w":["leaf",0]}]]}}}