176","6830197","1118"],"w":["leaf",0]},{"t":"Vamos perder tempo com este tipo de disparates agora?","e":"We tolerate wasting time with that kind of nonsense now?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.883764,"version":"labse-cosine/v1"},"x":"6300b3c972602930ec18ee61ba5dda21","i":"6a96d96121725402d288affe359fded3","r":"4114250:6351422:390:903642","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4114250","6351422","390"],"w":["leaf",0]},{"t":"Desculpe lá os disparates, não digo frase com frase.","e":"Excuse my French, I always 'put my mouth in my foot'.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.504713,"version":"labse-cosine/v1"},"x":"da5fc1459a27a25820ec512964203fc2","i":"8b1cfa290bfa52eff12ba4dfc26a9645","r":"3792960:6828348:595:579396","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3792960","6828348","595"],"w":["leaf",0]},{"t":"Só estás a dizer um monte de disparates.","e":"You're just talking a bunch of nonsense.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.843006,"version":"labse-cosine/v1"},"x":"7cf64a1e7485efaa06a18de5f2750c12","i":"95d7de46650e81e0cbdf509d85d59d38","r":"5465506:6649674:240:3690649","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5465506","6649674","240"],"w":["leaf",0]},{"t":"Se teve um emprego, deve ter feito disparates.","e":"If he did have a job, he probably fucked up.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.809709,"version":"labse-cosine/v1"},"x":"c6980de7364c70d7f7bf8cda0731b26f","i":"a59cce82b34bdbab811cfc2bcd6edf61","r":"3993250:6644798:380:777543","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3993250","6644798","380"],"w":["leaf",0]},{"t":"O que pensa que acontece a um deles, se faz disparates?","e":"Now, what do you think happens to one of those kids if they get into some nonsense?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.727571,"version":"labse-cosine/v1"},"x":"e7ee0355628d323314df343e820fb99c","i":"c88f4d039f831a02541e2ebbc6e0ebd7","r":"5668608:6751393:412:3958585","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5668608","6751393","412"],"w":["leaf",0]},{"t":"De todas os disparates que podias ter feito, este foi o pior.","e":"Of all those kinds of stunts you could have pulled, this was the worst.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.852369,"version":"labse-cosine/v1"},"x":"fafbd0aa6855dc07753a7956be1a5deb","i":"f993a84d83fb06df0f179f4d04d79d7a","r":"4810276:6248663:189:1911240","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4810276","6248663","189"],"w":["leaf",0]},{"t":"Da próxima vez, não me contes todos esses disparates.","e":"Next time, do not tell me all that nonsense.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.89346,"version":"labse-cosine/v1"},"x":"6cf3d5dae2e8b03164eb6fb946cb85a6","i":"c021ff988751052bac5cc04df7e09685","r":"5599680:6791683:289:3902984","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5599680","6791683","289"],"w":["leaf",0]}]]},"43318d51":{"m":[[{"t":"Estou a ser obrigado a fazer sacrifícios que, pensando bem, não quero fazer.","e":"I'm being kind of forced here to make sacrifices that, with good conscience, I don't really wanna make.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.817773,"version":"labse-cosine/v1"},"x":"919c8661bd2bb34ff876bef2b0c0d2d2","i":"030415c6353f4f27123853e435188557","r":"5893332:6950709:1770:4745909","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5893332","6950709","1770"],"w":["leaf",0]},{"t":"Todos os meus sacrifícios foram por água abaixo.","e":"All my sacrifices shot to hell.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.808044,"version":"labse-cosine/v1"},"x":"fb058b67d3ba3053e97956a88052af2a","i":"05f600e7e4566c0daed348dda096c79a","r":"5182092:6698819:392:3352467","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5182092","6698819","392"],"w":["leaf",0]},{"t":"E por vezes fazemos sacrifícios pelo bem comum.","e":"Sometimes we make sacrifices for the greater good.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.813203,"version":"labse-cosine/v1"},"x":"dc4fd5f71198951d4ef0601550bbe329","i":"16134b8b93aa29e9513a395255638aab","r":"4120734:6753779:371:921547","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4120734","6753779","371"],"w":["leaf",0]},{"t":"Se não estás preparada para sacrifícios necessários, tudo bem.","e":"Listen, if you're not ready to make the necessary sacrifices, that's fine.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.721841,"version":"labse-cosine/v1"},"x":"e2e0b214a0f0e95ad00ffe9fdd30bdaa","i":"22d38b7bcd371caf598271e1a07e0613","r":"4700086:6573918:335:2896911","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4700086","6573918","335"],"w":["leaf",0]},{"t":"E falando em sacrifícios necessários, estive a pensar, aqui deitado.","e":"And speaking of necessary sacrifices, I've been thinking about things, lying here.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.849661,"version":"labse-cosine/v1"},"x":"bb18221b0937915ece1e9d3d0bce8fc8","i":"24b2db8f7dd2761fd7eceec12425bb3b","r":"4581398:6445834:144:1739276","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4581398","6445834","144"],"w":["leaf",0]},{"t":"Mas às vezes são necessários sacrifícios para assegurar a vitória.","e":"But sometimes sacrifices must be made to ensure victory.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.906241,"version":"labse-cosine/v1"},"x":"dacf171ed680afc44f257cb18a2a1d08","i":"3e3182f3ed1f37834f5a4471505d9d7f","r":"3866846:6183434:165:655773","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3866846","6183434","165"],"w":["leaf",0]},{"t":"São os sacrifícios que um bom parceiro tem de fazer.","e":"But these are the sacrifices a wingman makes.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.516852,"version":"labse-cosine/v1"},"x":"ae6c6ee084d41fcdf2719f380facfa73","i":"9b531c92ede5643b8e1e5dec9a4b99c9","r":"5602016:6841233:493:3906883","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5602016","6841233","493"],"w":["leaf",0]},{"t":"Tenho pensado que não somos os únicos que fazemos sacrifícios.","e":"I've been thinking... They're not the only ones who sacrificed.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.724526,"version":"labse-cosine/v1"},"x":"71fa60e1d77309842dcd09dcd0004120","i":"b5a0fffe4dad111d4e3c2090e6b3107d","r":"6238676:6875993:156:4264427","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6238676","6875993","156"],"w":["leaf",0]},{"t":"Há sacrifícios maiores que se podem pedir do que enlouquecer um bocadinho.","e":"There are bigger sacrifices one might be asked to make than going a little mad.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.890233,"version":"labse-cosine/v1"},"x":"0877c9f6ac6a411f9a380dc7d632cec8","i":"b7eb08b054760492cbd814660cc2fab8","r":"5062946:6974480:289:4443418","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5062946","6974480","289"],"w":["leaf",0]},{"t":"Muitas vezes os sacrifícios são feitos para um bem maior.","e":"Sacrifices are often made for the greater good.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.854025,"version":"labse-cosine/v1"},"x":"e363e670ea4c942629d21b6be277a1f5","i":"d7b08a9fb685f5c87a8cb460c479f456","r":"4971222:6408304:235:2037846","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4971222","6408304","235"],"w":["leaf",0]},{"t":"A revolução exige sacrifícios. E por sinal, com perigo... Sim ou não?","e":"Fighting a revolution comes with sacrifice... and it goes without saying that it will dangerous, right?","s":"opensubtitles","ta":{"model":"sentence-transfor