df908b5","i":"015f713d10f1ea028b998f33b44fcd19","r":"3807522:6358755:346:587531","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3807522","6358755","346"],"w":["leaf",0]},{"t":"Eles não fazem absolutamente nenhuma referência a estas cavernas.","e":"They make absolutely no mention of these caves.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.870703,"version":"labse-cosine/v1"},"x":"21f09f41aee5b17197cd193638e2717b","i":"02266d50b09c2193abd96907459a2443","r":"4865474:6445817:252:1963967","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4865474","6445817","252"],"w":["leaf",0]},{"t":"O povo viveu em cavernas durante 150 mil anos, mas ninguém vive mais.","e":"Well, people lived in caves for 150,000 years, but they don't do it no more.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.830365,"version":"labse-cosine/v1"},"x":"90827056940a1a0ec4427c790bf8bc93","i":"5974cd3e9d57dc9ff1493881760eefca","r":"2582782:6813122:772:2347311","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2582782","6813122","772"],"w":["leaf",0]},{"t":"Quero, tipo, luz e ar, ele quer o homem das cavernas.","e":"I want, like, light and airy, and he wants man cave.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.81668,"version":"labse-cosine/v1"},"x":"818979921cd0c8ebac8546dabed247ba","i":"6c2bee42db7a0fc045a33de039e2ef7f","r":"5290072:6462683:79:3547209","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5290072","6462683","79"],"w":["leaf",0]},{"t":"E eu sou apenas um ... um homem das cavernas mudo.","e":"And I'm just a... a dumb caveman.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.87041,"version":"labse-cosine/v1"},"x":"17ed029ab591ce666dadc8ebb60cbe38","i":"bf903d79e46d1fa0c523998510d0b775","r":"4303552:6052764:854:1290628","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4303552","6052764","854"],"w":["leaf",0]},{"t":"Está bem, ganha o prémio de h