.php","d":["3862726","6114265","309"],"w":["leaf",0]},{"t":"Sim, isso é a coisa mais madura a fazer... para ambos. Sim eu concordo.","e":"That is the mature, responsible thing to do for each other and ourselves, yes I agree.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.633118,"version":"labse-cosine/v1"},"x":"c30a6278e1fcdea2c52755aaf148cfb1","i":"79ba1cc22cd8aa4c4517e0d5c41b6f65","r":"3165612:6589844:788 789:295560","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3165612","6589844","788 789"],"w":["leaf",0]}],[{"t":"Temos duas semanas de fruta madura pronta a vender.","e":"We got two weeks of ripe fruit ready to sell.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.911826,"version":"labse-cosine/v1"},"x":"c310b1343c2d096938d86a539a981516","i":"1bc716b16c4c8163b8f9947c673ec461","r":"4964764:6662840:310:3134132","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4964764","6662840","310"],"w":["leaf",0]},{"t":"Olhem para isto \"As sementes de uma fruta dragão madura\"","e":"Look at this... \"The seeds of a ripe dragon fruit","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.806828,"version":"labse-cosine/v1"},"x":"99daf5608938e5cfb8073a536586ce6e","i":"2c8c208b5e64f9f47c8b8478a7ef66d7","r":"5669120:6814640:329:3967271","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5669120","6814640","329"],"w":["leaf",0]},{"t":"A cada ramo, a fruta é menos madura e o macaco mais inferior.","e":"With each branch, the fruit is less ripe, and the monkey lower in rank.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.828131,"version":"labse-cosine/v1"},"x":"46515da1efd4304a73056519c4734770","i":"5fc71233dc0c37f3a345e558f1dd331e","r":"3660770:7054972:37:473004","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3660770","7054972","37"],"w":["leaf",0]}]]}}}