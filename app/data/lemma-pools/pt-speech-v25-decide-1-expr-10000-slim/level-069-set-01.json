a.org/en/sentences/show/2468708","tu":1,"w":["leaf",0]},{"t":"Mais uma vez, acho que isso se aplica mais a ti.","e":"Again, I feel that applies more to you.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.899774,"version":"labse-cosine/v1"},"x":"3e5b9536c955640a43efc3562f0ba503","i":"bf9f04d856f8ba40ec590d74fddf53c2","r":"3152624:6443703:1452:289810","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3152624","6443703","1452"],"w":["leaf",0]},{"t":"Isso também se aplica às noites de dança.","e":"That applies to dance nights as well.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.863662,"version":"labse-cosine/v1"},"x":"656bbf4cb434e7ad86ea208aae6255ea","i":"e6255fe409bdd15cc53a47b9d5b40532","r":"3464902:6528516:585:368633","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3464902","6528516","585"],"w":["leaf",0]}]]}}}