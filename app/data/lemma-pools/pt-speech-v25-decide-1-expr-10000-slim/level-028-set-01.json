8:683:3984513","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5700672","6764378","683"],"w":["leaf",0]}]]},"1bba6586":{"m":[[{"t":"Muitos dos seus membros, assassinos cruéis, têm uma tatuagem com este símbolo.","e":"Many of its members, cold-blooded killers, have a tattoo of this symbol.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.802778,"version":"labse-cosine/v1"},"x":"c7347f4f6dd992830156ffc8a2e5314f","i":"176fbc181dde1ef58a39be6d6d2463c8","r":"6692646:6931753:174:5230829","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6692646","6931753","174"],"w":["leaf",0]},{"t":"Não por a terem magoado ou terem sido cruéis.","e":"Not because they hurt her or were unkind.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.876831,"version":"labse-cosine/v1"},"x":"bb49275a7c7c99e8671b819ed71e9019","i":"1b062c0364000d4d6cef9748d2aec003","r":"5972632:6984682:263:4819313","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5972632","6984682","263"],"w":["leaf",0]},{"t":"Os homens poderosos não têm de ser cruéis.","e":"Powerful men do not have to be cruel.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.860261,"version":"labse-cosine/v1"},"x":"c79d075d8a5d7da7e54f0c3fa3e76556","i":"3514d1b23cb8ae4e06b1d412c31dd606","r":"2361317:7039872:781:2317677","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2361317","7039872","781"],"w":["leaf",0]},{"t":"Bem, os adolescentes são cruéis em qualquer lugar que se vá.","e":"Well, teenagers are cruel wherever you go.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.857806,"version":"labse-cosine/v1"},"x":"64104e104420aa732d5065f9fee429ce","i":"4c8b669a3606eec011023a949309c4c9","r":"4533828:6390837:214:1666316","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4533828","6390837","214"],"w":["leaf",0]},{"t":"Quando as pessoas forem cruéis, queres que te ame ainda mais.","e":"And when people are cruel, you want me to love you even more.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.837975,"version":"labse-cosine/v1"},"x":"64fd67f9d552173da70982663f805cef","i":"def9cf80976ccdce562ebcae92a888d0","r":"3780322:6691141:435:565515","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3780322","6691141","435"],"w":["leaf",0]},{"t":"Bem, nunca ninguém disse que os nazis eram estúpidos, apenas puramente cruéis.","e":"Well, no one ever said the Nazis were stupid, just pure evil.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.854904,"version":"labse-cosine/v1"},"x":"4d47c6df27d2ee09f3b6bd3473d359d8","i":"f4f545c1722c2c87f0b7538656673d4b","r":"6319590:7008265:616:5057473","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6319590","7008265","616"],"w":["leaf",0]},{"t":"É um truque praticado pelos cruéis sobre os tolos e fracos.","e":"It is a trick played by the cruel on the foolish and the weak.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.820047,"version":"labse-cosine/v1"},"x":"23665a44b77bf9b89605ece959d2f3a5","i":"a4f51e05d6495002542b3874babe8750","r":"2381991:6698601:91:2321788","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2381991","6698601","91"],"w":["leaf",0]},{"t":"Os homens são cruéis, mas o Homem é gentil.","e":"Men are cruel, but Man is kind.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.914446,"version":"labse-cosine/v1"},"x":"64f5975ffff1246df0802cb0e4873529","i":"f01cc33518734a34f42f219dbffe85aa","r":"2968622:2968620","c":"carlosalberto","su":"https://tatoeba.org/en/sentences/show/2968622","ul":"https://tatoeba.org/en/sentences/show/2968622","b":"Tatoeba sentence #2968622 by carlosalberto; English translation #2968620 by carlosalberto","o":"https://tatoeba.org/en/sentences/show/2968622","tu":1,"w":["leaf",0]}],[],[{"t":"Ele disse algumas... coisas muito cruéis, e eu prefiro deixar as coisas assim.","e":"He said some... Very vile things, and I'd rather leave it at that.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.911818,"version":"labse-cosine/v1"},"x":"a8a4853625fa57fc10e64c39ddbc8a78","i":"3e39527175b015d7f26c24950a155e19","r":"3503406:6810980:742:2449505","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3503406","6810980","742"],"w":["leaf",0]},{"t":"Esta é uma das mais cruéis e mais injustas decisões já tomadas.","e":"It's one of the cruelest, unfairest decisions ever rendered.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.850745,"version":"labse-cosine/v1"},"x":"9f5d44e3432d9471dfd5858123da74dc","i":"e73207718f27b9a1dfc22e2b242329a4","r":"4277116:6735761:601:2647326","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4277116","6735761","601"],"w":["leaf",0]},{"t":"Eu disse-te algumas coisas cruéis e peço desculpa.","e":"I said some cruel things to you and I'm very sorry.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.877702,"version":"labse-cosine/v1"},"x":"3eefb27bf80868796e580b2fd84d2fd0","i":"4fe48e0846a48cc6de44715ce6d67102","r":"5931656:7013251:402:4777309","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5931656","7013251","402"],"w":["leaf",0]}]]}}}