:307:811809","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4028060","6640098","307"],"w":["leaf",0]},{"t":"E você deixou-me ficar aqui sentada, como uma tonta o dia todo?","e":"And you let me sit here, like a fool, all day?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.896438,"version":"labse-cosine/v1"},"x":"817d1f0bab8a8e1be5abb22cb8f31f6b","i":"2103edf40f44a93f05d199e5679c1f17","r":"3781964:6107543:84:570239","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3781964","6107543","84"],"w":["leaf",0]}]]},"3e7327bd":{"m":[[{"t":"Estão todos bastante tontos, mas, vão ficar bem.","e":"I got the door open. They're all pretty woozy, but I think they're going to be okay.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.631192,"version":"labse-cosine/v1"},"x":"15c1dc8420832452ad86e235a1d37c19","i":"3bea991418dc95c9e9d9ed6f2427c24b","r":"4381266:6285484:525:1409061","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4381266","6285484","525"],"w":["leaf",0]},{"t":"E estamos todos um pouco tontos, neste momento.","e":"And we're all just a little numb right now.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.876624,"version":"labse-cosine/v1"},"x":"af7f9056ec79cd6e57af61be94d33add","i":"3d2de3b05c1ef2fcbf4fcf8808d22102","r":"3687398:6606259:458:495358","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3687398","6606259","458"],"w":["leaf",0]},{"t":"Não há fim à vista e acabamos tontos.","e":"No end in sight and you just end up dizzy.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.753944,"version":"labse-cosine/v1"},"x":"e0aeb714cad5dc8346a6fc0778e591b4","i":"879ec26db1942bf4faf46d0ffa715478","r":"4344332:6725469:81:1345577","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4344332","6725469","81"],"w":["leaf",0]},{"t":"Vamos voltar à parte de estarmos tontos juntos.","e":"Oh, let's just go back to being dizzy together.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.672955,"version":"labse-cosine/v1"},"x":"8702f05687037c8bf324ad33515c8bac","i":"e759504f2391d8fa0c8a5d3dab879468","r":"6212014:7013665:61:4966488","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6212014","7013665","61"],"w":["leaf",0]},{"t":"Se estão tontos ou fracos, informem um colega.","e":"If you are dizzy or weak, inform a co-worker now.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.762689,"version":"labse-cosine/v1"},"x":"e69db1accef5f02e9a8a98a9f1120880","i":"e8e2507383fa3eae517ae07903a0fe9b","r":"5215278:6969837:511:3421119","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5215278","6969837","511"],"w":["leaf",0]}],[{"t":"Só precisamos apanhar uns turistas tontos que nos dêem dinheiro.","e":"- You just wanna look for goofy tourists that wanna give us their money.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.763422,"version":"labse-cosine/v1"},"x":"e0ea84af23d2be3a0b9ced5338dbee10","i":"da30099c26eb4a31e4ab69509b291674","r":"4106306:6601792:473:893150","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4106306","6601792","473"],"w":["leaf",0]}],[],[{"t":"O que é que os tontos do zombies estão a tramar esta semana?","e":"What are those pesky zombies up to this week?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.833555,"version":"labse-cosine/v1"},"x":"1bffd06f063a39e8fca6b0bcd79cbee5","i":"36a9a261bbbb3fb47b757c668310e155","r":"4665126:6337176:815:1806793","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4665126","6337176","815"],"w":["leaf",0]},{"t":"Mas os tontos que os perseguem podem às vezes apanhar algo interessante.","e":"But the fools that chase them can sometimes come up with something interesting.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.887158,"version":"labse-cosine/v1"},"x":"20dee6df749879ef1ca2d04a3f70df1f","i":"6c33ba9abdcca87b1c8fafb1371676eb","r":"3711274:6020456:159:508817","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3711274","6020456","159"],"w":["leaf",0]},{"t":"Os preconceitos são os que os tontos usam como razões.","e":"Prejudices are what fools use for reasons.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.827492,"version":"labse-cosine/v1"},"x":"ff340900b2b461c68a6905de25f5e231","i":"aac0f2527e2691b1fe1fa9dbaf4ea782","r":"1412196:1398497","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/1412196","ul":"https://tatoeba.org/en/sentences/show/1412196","b":"Tatoeba sentence #1412196 by alexmarcelo; English translation #1398497 by bart","o":"https://tatoeba.org/en/sentences/show/1412196","tu":1,"w":["leaf",0]},{"t":"\"Pobres tontos do 51º a sentir a falta de seus dois melhores bombeiros.\"","e":"\"Poor saps on 51 are missing their two best firefighters.\"","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.904878,"version":"labse-cosine/v1"},"x":"a2b93394e042473d1490a638c9f35861","i":"b83c32890e8b5652c7fa59f5dfef0b6b","r":"5232810:6459367:428:3451206","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5232810","6459367","428"],"w":["leaf",0]},{"t":"E o que faz aos homens tontos como o senhor e o Presidente Nava?","e":"And what it does to fools like you and President Nava?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.880564,"version":"labse-cosine/v1"},"x":"900e36357b90e044050bab44151e8cfb","i":"c84a4a750176ca9554ba22f73e2cac09","r":"6692652:6931999:354:5231736","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6692652","6931999","354"],"w":["leaf",0]},{"t":"Mesmo quando os estava a matar... eles só me olhavam... Como tontos.","e":"Even when I was killing them, they just gaped at me... like fools.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.906424,"version":"labse-cosine/v1"},"x":"848fa234d4b18290924b5947b5f69e28","i":"b8f0cd8c687e3fae8bafbaff50a83