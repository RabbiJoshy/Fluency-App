ae8e9c4108","i":"a29af9bdc096662aa825b2e2c8460b93","r":"3515632:6912198:1236:397931","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3515632","6912198","1236"],"w":["leaf",0]},{"t":"Como te disse ontem, só restam aqui esposas, crianças e falhados.","e":"Like I told you yesterday. Nobody left here but... wives, kids... and dead-enders.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.822114,"version":"labse-cosine/v1"},"x":"767cd440e7638842e087e0fe419778bb","i":"b2fe15c8ec6f910c76eab1e181e746d4","r":"2494362:6431494:98:188031","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2494362","6431494","98"],"w":["leaf",0]},{"t":"- Os meus satélites mostram que restam 4.472 humanos na superfície da Terra.","e":"- You come here to gloat?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.203426,"version":"labse-cosine/v1"},"x":"f8eb930acc6e14420646eb6b788ae4e0","i":"02d66cc9e05f05c9d08252c2d4f388d9","r":"2592614:6926030:68 67:2347743","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2592614","6926030","68 67"],"w":["leaf",0]}]]},"d8aa2e2b":{"m":[[{"t":"E, agora, querem que vos ajude a salvar o que restou?","e":"I was just a prisoner. And now you want me to help you save whatever was left behind?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.711195,"version":"labse-cosine/v1"},"x":"f4154b25bf874e2990ff3438e4ba4e5e","i":"0ccf8ecad7931fa390e00f1bd3d12e27","r":"5163556:6783496:298:3325866","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5163556","6783496","298"],"w":["leaf",0]},{"t":"Não restou o suficiente dela para um funeral apropriado.","e":"There wasn't enough of her left for a proper burial.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.866251,"version":"labse-cosine/v1"},"x":"8e21ef86f82d03e29dc1e195ea2d6819","i":"262a7dc1e58755521d244c35d5733703","r":"4857478:6522352:89:3024388","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4857478","6522352","89"],"w":["leaf",0]},{"t":"Só lhe restou uma irmã fria e perturbada.","e":"Left only to her cold, deranged big sister.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.711789,"version":"labse-cosine/v1"},"x":"ac2678950be7f59adc21f51ccddc0a41","i":"27565115e941d99fa4a2f60725c0b173","r":"4493526:6377067:811:1592876","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4493526","6377067","811"],"w":["leaf",0]},{"t":"A única coisa que restou da minha vida.","e":"The only thing left of my life.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.893186,"version":"labse-cosine/v1"},"x":"da4c7d5ee9d6808ec2c26171dc916636","i":"29106f581b8be6837461f80a8ba877a8","r":"3774694:6688428:124:551478","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3774694","6688428","124"],"w":["leaf",0]},{"t":"Aqui este pequeno grupo é tudo o que restou.","e":"This little group here, are all that are left.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.881815,"version":"labse-cosine/v1"},"x":"7ac01446dd914ad32a78dba7683212a3","i":"29f88d4c1915c53f5f6e2689773c60a8","r":"6214322:6854646:37:4256463","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6214322","6854646","37"],"w":["leaf",0]},{"t":"Vocês são tudo o que restou da minha família.","e":"You're all I have left of my family.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.877823,"version":"labse-cosine/v1"},"x":"3a8d4a995caffeb14c129e5c7a630a6e","i":"5e5f11de5245cdb2959bc09b9e55c47e","r":"4166440:6507270:709:1010882","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4166440","6507270","709"],"w":["leaf",0]},{"t":"E como conseguiu ser o único que restou vivo?","e":"And how did you manage to be th e only one left alive?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.935241,"version":"labse-cosine/v1"},"x":"45e377fac306d2a0ec6bd6f85f22d84b","i":"7af93706b11a2b9781e857024d2766ae","r":"3327624:6341575:566:344554","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3327624","6341575","566"],"w":["leaf",0]},{"t":"Já disse não restou ninguém para guardar o lugar.","e":"I told you ... there's no one left to guard the place.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.836534,"version":"labse-cosine/v1"},"x":"f2255204f67596943793a61a9c60d119","i":"7fdc3adce10138c30771cfba8de73463","r":"4235544:6936213:478:1137775","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4235544","6936213","478"],"w":["leaf",0]},{"t":"Graças ao meu pai só restou um único.","e":"Because of my dad is just one of them left alive.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.75378,"version":"labse-cosine/v1"},"x":"252dd822ce5185c3a8962548c32dba6a","i":"8221b7370d44bb39470b8748b526adec","r":"4336592:6535744:44:1332552","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4336592","6535744","44"],"w":["leaf",0]}]]},"d200d295":{"m":[[{"t":"Disseram que me podia sentir um pouco tonta nos próximos dias.","e":"They said I might have some dizziness over the next few days.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.840313,"version":"labse-cosine/v1"},"x":"2006a01791342cb0e97d205d06ac0dcc","i":"095d4c6adb0daa0a6e516793dab37201","r":"6684320:7062842:303:5223949","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6684320","7062842","303"],"w":["leaf",0]},{"t":"Quando já não estiver tão tonta, talvez tente.","e":"When my head stops spinning, I'll give it a go.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.344415,"version":"labse-cosine/v1"},"x":"c7d47bb0238d4279a71180138ca55663","i":"29d4c5915f833e321a6e49be17f7c7fd","r":"1929276:6518549:383:85742","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1929276","6518549","383"],"w":["leaf",0]},{"t":"Ela ficou tonta assim que saiu da cama.","e":"She was dizzy when she first got out of bed.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.773836,"version":"labse-cosine/v1"},"x":"c64f2020092819a05dd4f35eccddd0b1","i":"3ad81e671cc4ff522ef6b91391f44c01","r":"4491624:6118213:172:1586583","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4491624","6118213","172"],"w":["leaf",0]},{"t":"Ela disse que ficou tonta antes da queda.","e":"She said she was dizzy before the fall.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.80798,"version":"labse-cosine/v1"},"x":"8dc11cbbaef6f2cb76ad15266f467841","i":"3e0b3d540136f0efaa9f2b3323ee1830","r":"4491624:6118213:145:1586558","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4491624","6118213","145"],"w":["leaf",0]},{"t":"Não podes estar tonta se estiveres a dormir.","e":"You can't be dizzy when you're asleep.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.82031,"version":"labse-cosine/v1"},"x":"6340dc83c94329817bf42afa8d191ec9","i":"c144cd4b2fd7e6a9e5e4f22dc0ce062a","r":"4007078:6770158:299:799632","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4007078","6770158","299"],"w":["leaf",0]},{"t":"Ele está correndo por aí como uma barata tonta.","e":"He is running around like a headless chicken.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.747131,"version":"labse-cosine/v1"},"x":"891c587caa307a542cc55c36ff7448c3","i":"5132e4bc0baa161c9b508760c441bdbf","r":"3813291:3807676","c":"IsabelleRain","su":"https://tatoeba.org/en/sentences/show/3813291","ul":"https://tatoeba.org/en/sentences/show/3813291","b":"Tatoeba sentence #3813291 by IsabelleRain; English translation #3807676 by muriloricci","o":"https://tatoeba.org/en/sentences/show/3813291","tu":1,"w":["leaf",0]},{"t":"Quando eu me levantei, minha cabeça estava tonta.","e":"When I stood up, my head was swimming.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.737266,"version":"labse-cosine/v1"},"x":"ae4b0fe01142e5be38f1c37e44380f79","i":"f4bfd0124537501c39b8c5e3ebcc2d90","r":"10577453:325433","c":"lucasmg123","su":"https://tatoeba.org/en/sentences/show/10577453","ul":"https://tatoeba.org/en/sentences/show/10577453","b":"Tatoeba sentence #10577453 by lucasmg123; English translation #325433 by CM","o":"https://tatoeba.org/en/sentences/show/10577453","tu":1,"w":["leaf",0]},{"t":"Eu estava numa reunião, fiquei tonta e acordei aqui, mas estou bem agora.","e":"Look, I was in a meeting, I felt dizzy, and I woke up here, but I feel fine now.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.802562,"version":"labse-cosine/v1"},"x":"7143cbf13e263950e615b53485bc7d2d","i":"4202903c2a266fca11778d3290a109a4","r":"5058602:6383765:199:2103099","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5058602","6383765","199"],"w":["leaf",0]},{"t":"Todo este rodar está-me a fazer ficar tonta.","e":"All this spinning is making me dizzy.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.866717,"version":"labse-cosine/v1"},"x":"d839a29b261baee8d54c3da176c39a76","i":"f7bdd11f8c221e34ad3c580d05a6ab03","r":"5028904:6660756:610:3180265","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5028904","6660756","610"],"w":["leaf",0]},{"t":"Você já se sentiu tonta num avião?","e":"Have you ever felt dizzy on a plane?","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.883475,"version":"labse-cosine/v1"},"x":"0c18646655b5ab64a6aadd7d3cdfbce6","i":"100ed1c177f672c529c6b1cccebd73c1","r":"1718422:1717668","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/1718422","ul":"https://tatoeba.org/en/sentences/show/1718422","b":"Tatoeba sentence #1718422 by alexmarcelo; English translation #1717668 by Amastan","o":"https://tatoeba.org/en/sentences/show/1718422","tu":1,"w":["leaf",0]},{"t":"Não, a dança não me fez ficar tonta.","e":"No, dance didn't make me dizzy.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.88622,"version":"labse-cosine/v1"},"x":"e88492183ba9339de83fd127d1ee9bdf","i":"6de72e4efc04ab26163e69beea432a23","r":"5028904:6660756:957:3180610","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5028904","6660756","957"],"w":["leaf",0]}],[],[{"t":"Estou só a tentar por a casa mais bonita para vocês, tonta.","e":"Just trying to make the place look nice for you, you knucklehead.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.742226,"version":"labse-cosine/v1"},"x":"d3d3de939f77d282d2f6a4e657aa7427","i":"64163536c24ef4e2f983a3524cf49b15","r":"4028060:6640098:307:811809","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4028060","6640098","307"],"w":["leaf",0]},{"t":"E você deixou-me ficar aqui sentada, como uma tonta o dia todo?","e":"And you let me sit here, like a fool, all day?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.896438,"version":"labse-cosine/v1"},"x":"817d1f0bab8a8e1be5abb22cb8f31f6b","i":"2103edf40f44a93f05d199e5679c1f17","r":"3781964:6107543:84:570239","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3781964","6107543","84"],"w":["leaf",0]}]]}}}