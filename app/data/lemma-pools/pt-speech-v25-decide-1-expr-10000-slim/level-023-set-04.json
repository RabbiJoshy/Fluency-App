f0efaa9f2b3323ee1830","r":"4491624:6118213:145:1586558","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4491624","6118213","145"],"w":["leaf",0]},{"t":"Não podes estar tonta se estiveres a dormir.","e":"You can't be dizzy when you're asleep.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.82031,"version":"labse-cosine/v1"},"x":"6340dc83c94329817bf42afa8d191ec9","i":"c144cd4b2fd7e6a9e5e4f22dc0ce062a","r":"4007078:6770158:299:799632","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4007078","6770158","299"],"w":["leaf",0]},{"t":"Ele está correndo por aí como uma barata tonta.","e":"He is running around like a headless chicken.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.747131,"version":"labse-cosine/v1"},"x":"891c587caa307a542cc55c36ff7448c3","i":"5132e4bc0baa161c9b508760c441bdbf","r":"3813291:3807676","c":"IsabelleRain","su":"https://tatoeba.org/en/sentences/show/3813291","ul":"https://tatoeba.org/en/sentences/show/3813291","b":"Tatoeba sentence #3813291 by IsabelleRain; English translation #3807676 by muriloricci","o":"https://tatoeba.org/en/sentences/show/3813291","tu":1,"w":["leaf",0]},{"t":"Quando eu me levantei, minha cabeça estava tonta.","e":"When I stood up, my head was swimming.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.737266,"version":"labse-cosine/v1"},"x":"ae4b0fe01142e5be38f1c37e44380f79","i":"f4bfd0124537501c39b8c5e3ebcc2d90","r":"10577453:325433","c":"lucasmg123","su":"https://tatoeba.org/en/sentences/show/10577453","ul":"https://tatoeba.org/en/sentences/show/10577453","b":"Tatoeba sentence #10577453 by lucasmg123; English translation #325433 by CM","o":"https://tatoeba.org/en/sentences/show/10577453","tu":1,"w":["leaf",0]},{"t":"Eu estava numa reunião, fiquei tonta e acordei aqui, mas estou bem agora.","e":"Look, I was in a meeting, I felt dizzy, and I woke up here, but I feel fine now.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","sco