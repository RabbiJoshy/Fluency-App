":["4831834","6521345","563"],"w":["leaf",0]},{"t":"Ainda bem que não é perto de nenhum órgão vital.","e":"He's lucky it's not near any vital organs.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.810811,"version":"labse-cosine/v1"},"x":"82a334320b9ef0466b3b26237042ae34","i":"e9ff99a1e017b58b44109e8805fe730c","r":"5081416:6931078:388:3234503","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5081416","6931078","388"],"w":["leaf",0]},{"t":"É o órgão mais importante, e não possuem um reserva.","e":"It's your most important organ, and you've no back up.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.797888,"version":"labse-cosine/v1"},"x":"2e0e9672616b25b343dfaa023fc8e122","i":"f4471ca0fadd1d18c9c0183b04c96968","r":"6340138:7042315:265:5069037","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6340138","7042315","265"],"w":["leaf",0]},{"t":"Ele deve possuir um órgão transmissor de energia muito potente.","e":"I mean, it must have... a very powerful electro-transmitting organ.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.760143,"version":"labse-cosine/v1"},"x":"1a77b9da945491b663e6a25bde7fc887","i":"f48a6cbb61a633e2e57d5584b24b8741","r":"5828640:6811911:893:4048029","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5828640","6811911","893"],"w":["leaf",0]},{"t":"É um rapaz que precisa de um órgão, e um paciente que tem um para doar.","e":"It's a child who needs an organ and a patient with one to give.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.834391,"version":"labse-cosine/v1"},"x":"0a11e040d9c4310146d447eae9905524","i":"a8ac2952b74eddef5f4e9899d87ca1d6","r":"4491626:6110280:600:1587835","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4491626","6110280","600"],"w":["leaf",0]}]]}}}