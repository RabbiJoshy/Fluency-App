14207","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3830162","6853969","1024"],"w":["leaf",0]},{"t":"Isso é o que dizem todos os advogados que têm algo a esconder.","e":"That is what every lawyer who has had something to hide has ever said.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.767756,"version":"labse-cosine/v1"},"x":"fd61e19d82475cdffaa3517760515697","i":"a7184ad4c0891a7631d26766a75a75dd","r":"4649074:6654449:383:1787002","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4649074","6654449","383"],"w":["leaf",0]},{"t":"Algumas pessoas pensam que há advogados demais nesse país.","e":"Some people think that there are way too many lawyers in this country.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.892333,"version":"labse-cosine/v1"},"x":"3c645c720b7e3a98752e27a3a8ed59da","i":"e7004a3d5714c1eca5300bad27e82ba2","r":"2825553:1202240","c":"MarlonX19","su":"https://tatoeba.org/en/sentences/show/2825553","ul":"https://tatoeba.org/en/sentences/show/2825553","b":"Tatoeba sentence #2825553 by MarlonX19; English translation #1202240 by CK","o":"https://tatoeba.org/en/sentences/show/2825553","tu":1,"w":["leaf",0]},{"t":"Algumas pessoas acham que há advogados demais neste país.","e":"Some people think that there are too many lawyers in this country.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.869372,"version":"labse-cosine/v1"},"x":"6533c7923512f65229051dbe7ff97a77","i":"fb2fe93db1af1dd3d9676ef8e8b9fb53","r":"1207141:1205642","c":"alicup","su":"https://tatoeba.org/en/sentences/show/1207141","ul":"https://tatoeba.org/en/sentences/show/1207141","b":"Tatoeba sentence #1207141 by alicup; English translation #1205642 by CK","o":"https://tatoeba.org/en/sentences/show/1207141","tu":1,"w":["leaf",0]},{"t":"Deves ter tido uma equipa de advogados a analisar isso.","e":"You must have a team of lawyers looking at this place.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.784445,"version":"labse-cosine/v1"},"x":"4f26e0a5aaf6fcce745fa4e37331cfb0","i":"53aa33b0b9ee5fa37ff30a4213a5322b","r":"4625866:6872196:50:2827340","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4625866","6872196","50"],"w":["leaf",0]},{"t":"Meu pai e eu, ainda trabalhamos como advogados.","e":"My father and I still work as lawyers.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.929971,"version":"labse-cosine/v1"},"x":"86cc245518e966614fd40a50ee56785f","i":"1e6e923b20ab323d213ae8b7ec3bac89","r":"8197924:8212329","c":"josivangoncalves","su":"https://tatoeba.org/en/sentences/show/8197924","ul":"https://tatoeba.org/en/sentences/show/8197924","b":"Tatoeba sentence #8197924 by josivangoncalves; English translation #8212329 by josivangoncalves","o":"https://tatoeba.org/en/sentences/show/8197924","tu":1,"w":["leaf",0]},{"t":"A maioria das pessoas aceita conselhos dos seus advogados.","e":"Most people take advice from their lawyers.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.894022,"version":"labse-cosine/v1"},"x":"eae79e3f6419999c38a378aafc17c2ac","i":"71bb13a39adfc1b781137fc4172156f5","r":"2404425:6210944:669:165453","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2404425","6210944","669"],"w":["leaf",0]},{"t":"Ele teve três filhos que se tornaram advogados.","e":"He had three sons who became lawyers.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.923059,"version":"labse-cosine/v1"},"x":"a23c1109621705649061bf7ffda3c68b","i":"131d404019d20ec43cf8e11971e05256","r":"937309:284914","c":"une_monica","su":"https://tatoeba.org/en/sentences/show/937309","ul":"https://tatoeba.org/en/sentences/show/937309","b":"Tatoeba sentence #937309 by une_monica; English translation #284914 by mamat","o":"https://tatoeba.org/en/sentences/show/937309","tu":1,"w":["leaf",0]},{"t":"Muitas pessoas pensam que os advogados ganham demais.","e":"A lot of people think that lawyers get paid too much.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.878627,"version":"labse-cosine/v1"},"x":"df1e5d59738de01d0d9a272d3e30e1fb","i":"0416b2f20805cd15e0ee6fc7e42ced36","r":"1656690:1553539","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/1656690","ul":"https://tatoeba.org/en/sentences/show/1656690","b":"Tatoeba sentence #1656690 by alexmarcelo; English translation #1553539 by CK","o":"https://tatoeba.org/en/sentences/show/1656690","tu":1,"w":["leaf",0]},{"t":"Bem se não me disseres, talvez digas aos advogados.","e":"Well... if you won't tell me, maybe you'll tell the lawyers.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.895508,"version":"labse-cosine/v1"},"x":"14fc807091a58a0f153e1b162e61369d","i":"2c2aa3912217c7dd39062fd1b6f5b3e4","r":"5174274:6938794:544:4456162","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5174274","6938794","544"],"w":["leaf",0]},{"t":"Agora nós temos mais advogados do que homens honestos.","e":"We now have more lawyers than honest men.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.903487,"version":"labse-cosine/v1"},"x":"0ed8cc164caafc8e1ba481cbcb994461","i":"531f69bc1f02d91c72bbfd4202c0dc5a","r":"2758036:2617168","c":"Sitko","su":"https://tatoeba.org/en/sentences/show/2758036","ul":"https://tatoeba.org/en/sentences/show/2758036","b":"Tatoeba sentence #2758036 by Sitko; English translation #2617168 by Prophete","o":"https://tatoeba.org/en/sentences/show/2758036","tu":1,"w":["leaf",0]},{"t":"Não, eu... Está tudo tratado. Falei com os advogados e tudo.","e":"No, I... it's all settled.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.785267,"version":"labse-cosine/v1"},"x":"e76c9936b32545c81049bcf967ec5924","i":"03595eb8b7d966cd92424fb33d60e419","r":"5116688:6702417:313 314 315:2146611","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5116688","6702417","313 314 315"],"w":["leaf",0]},{"t":"Os advogados são como pulgas no meu rabo.","e":"Lawyer is like a leech on my ass.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.807997,"version":"labse-cosine/v1"},"x":"562b92abc67c3cacd74e7e5a9ee0404d","i":"66407956c582b681f96cff36390165a5","r":"5583152:6841229:391:3861822","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5583152","6841229","391"],"w":["leaf",0]},{"t":"Pensava que os advogados só podiam exercer depois dos 80.","e":"I thought you had to be, like, at least 80 to be a lawyer.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.700309,"version":"labse-cosine/v1"},"x":"c666a2d89c2fdee2dcdc19e75b35e688","i":"c1fe53a7294e756c1dcc95f7ee7ea2aa","r":"1860213:6658046:989:2278674","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1860213","6658046","989"],"w":["leaf",0]}]]},"c2891917":{"m":[[{"t":"Não vou dizer nada sem a minha advogada.","e":"I'm not talking until my lawyer is here.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.700565,"version":"labse-cosine/v1"},"x":"700a16b4da1edc97d121473f0857dbc4","i":"11d4449733d5db180ece6220f8cae8bb","r":"4923908:6511648:39:1991148","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4923908","6511648","39"],"w":["leaf",0]},{"t":"Pareces não te importar nada com o cheque da advogada.","e":"You don't seem to mind the lawyer's paycheck.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.820876,"version":"labse-cosine/v1"},"x":"955dde4456bad8072e74295c5ed73fa6","i":"2842d6926dd845dd6ea83f76348469e7","r":"3257538:6803030:485:317859","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3257538","6803030","485"],"w":["leaf",0]},{"t":"Eu conheço uma boa advogada que pode te ajudar.","e":"I know a good lawyer who can help you.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.913673,"version":"labse-cosine/v1"},"x":"d95266d9ddcd5b3d08ece0662db81fd8","i":"3a40c37f35d522f23cbbcb52123cd440","r":"1586886:1586726","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/1586886","ul":"https://tatoeba.org/en/sentences/show/1586886","b":"Tatoeba sentence #1586886 by alexmarcelo; English translation #1586726 by Gulliver","o":"https://tatoeba.org/en/sentences/show/1586886","tu":1,"w":["leaf",0]},{"t":"Que tipo de carro terá a minha advogada?","e":"What kind of car would my lawyer be driving?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.907808,"version":"labse-cosine/v1"},"x":"f8c504936896b6a49bec9a0c26872820","i":"5cbee70583381284bbf409a799f67d77","r":"3393786:6858210:386:2433291","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3393786","6858210","386"],"w":["leaf",0]},{"t":"Se algum dia eu matar alguém, serás minha advogada de defesa?","e":"If I ever murder someone, can I have you as my defence lawyer?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.849375,"version":"labse-cosine/v1"},"x":"7f4e20203e2b0d43c0f15cc0c7bc22dc","i":"cd72e4d99afccf3086564d88dac40c0a","r":"5685400:6964560:47:3972741","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5685400","6964560","47"],"w":["leaf",0]},{"t":"Acho que és uma boa advogada que cometeu um erro.","e":"I think you're a good lawyer that made a mistake.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.863685,"version":"labse-cosine/v1"},"x":"edb83b52898cea9e78ffc37e5bbb9ded","i":"e4649ba9b2b10a053fd979bd2eafe1c4","r":"5880940:7013653:170:4079869","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5880940","7013653","170"],"w":["leaf",0]},{"t":"Olhas para a advogada de defesa mesmo nos olhos.","e":"You look the defense attorney's right in the eye.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.850254,"version":"labse-cosine/v1"},"x":"b77f419e6dd144d58d01df5cc9cf9029","i":"20b772c96782826fe1b2ec2ff02bbdd3","r":"5553648:6634937:520:3823488","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5553648","6634937","520"],"w":["leaf",0]},{"t":"Foste substituída por uma advogada com um registo melhor.","e":"You got passed over for an attorney with a better record.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.813278,"version":"labse-cosine/v1"},"x":"9b3647ff2cfc4cb8fbb8fefe18b3ee2e","i":"a7654fe46b179e705ae966ad55f85efd","r":"5245076:6597749:443:3486036","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5245076","6597749","443"],"w":["leaf",0]},{"t":"Depois de te formares, serás um advogada rica.","e":"After you graduate, you're gonna be a rich attorney.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.875348,"version":"labse-cosine/v1"},"x":"fe9744b1e47b358641864c0458659bbc","i":"2464fa45ac89f5f5cbc69e5d72221ac7","r":"5673908:6653915:298:3969329","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5673908","6653915","298"],"w":["leaf",0]},{"t":"Mas alguém lembrou-me porque é que sou advogada.","e":"Then someone reminded me why I became a lawyer in the first place.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.716041,"version":"labse-cosine/v1"},"x":"6d94563e0f96c56f143ca22944720023","i":"1d79b37bdb5e1f137b7fda15a7e679ae","r":"4006600:6299533:557:797524","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4006600","6299533","557"],"w":["leaf",0]},{"t":"Tu és uma grande advogada, Lucy, com um grande futuro.","e":"You're a great lawyer, Lucy, with a great future.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.902329,"version":"labse-cosine/v1"},"x":"f02e693dbd9820471b5303782dc1d62b","i":"4df5f212bc64054fc0bd5ba1246414fb","r":"5280798:6824433:327:3541080","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5280798","6824433","327"],"w":["leaf",0]},{"t":"Tom não tem condições de contratar uma advogada.","e":"Tom can't afford to hire a lawyer.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.864705,"version":"labse-cosine/v1"},"x":"3fce35a0effd7f799ae908f0d7f19b7b","i":"446f2804d848f2ea45545a552976b5a8","r":"11215070:7543334","c":"bill","su":"https://tatoeba.org/en/sentences/show/11215070","ul":"https://tatoeba.org/en/sentences/show/11215070","b":"Tatoeba sentence #11215070 by bill; English translation #7543334 by CK","o":"https://tatoeba.org/en/sentences/show/11215070","tu":1,"w":["leaf",0]},{"t":"Mandando o meu marido para a melhor advogada de divórcios da cidade?","e":"By sending my husband to the city's top divorce attorney?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.763985,"version":"labse-cosine/v1"},"x":"cdf8ff67f949c8b37083ecf575920e06","i":"2da115c47aba89fb8a4c25f02fa09def","r":"5030300:6766300:538:2079903","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5030300","6766300","538"],"w":["leaf",0]},{"t":"O que é que a tua advogada acha?","e":"What does your lawyer think?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.945342,"version":"labse-cosine/v1"},"x":"0cbbfb98bcc26911c1cb1aeb028b5dc4","i":"a16997e651fcf1db6aeaf4e6705fe1e0","r":"4289376:6110787:686:1260358","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4289376","6110787","686"],"w":["leaf",0]},{"t":"Percebo o que queres dizer, mas estou a dizer-te como advogada, não podes.","e":"I know you mean it, but I'm telling you as a lawyer, you can't.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.880096,"version":"labse-cosine/v1"},"x":"4153151b464f9d1b942e5f03faa45723","i":"9aacdd4936883e500a67fb2847598813","r":"5033480:6367662:304:2083416","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5033480","6367662","304"],"w":["leaf",0]}]]},"d2f323a0":{"m":[[{"t":"Temos que correr, ou as lojas vão fechar.","e":"We have to hurry, or the stores will close.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.871915,"version":"labse-cosine/v1"},"x":"84cf1d041c03c46970d4f9cecdc6fc0f","i":"1b546e85756abb1dee859b0abd110b40","r":"11144590:9004520","c":"MrJuice","su":"https://tatoeba.org/en/sentences/show/11144590","ul":"https://tatoeba.org/en/sentences/show/11144590","b":"Tatoeba sentence #11144590 by MrJuice; English translation #9004520 by mccarras","o":"https://tatoeba.org/en/sentences/show/11144590","tu":1,"w":["leaf",0]},{"t":"Eu não gosto mesmo das lojas de lá.","e":"I don't really like the stores there.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.940466,"version":"labse-cosine/v1"},"x":"d30435eaeeb9603cefcbc6e99e3d6a03","i":"567d041ee9e81c0a76b84b996d196d46","r":"1862531:31122","c":"gleydin","su":"https://tatoeba.org/en/sentences/show/1862531","ul":"https://tatoeba.org/en/sentences/show/1862531","b":"Tatoeba sentence #1862531 by gleydin; English translation #31122 by CK","o":"https://tatoeba.org/en/sentences/show/1862531","tu":1,"w":["leaf",0]},{"t":"Podemos procurar em todas as lojas e casas nesta rota.","e":"We could canvass all the shops and homes along this route.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.868454,"version":"labse-cosine/v1"},"x":"87463f371485630d009cbaa9a3fa1707","i":"642554928d4fba89d38a686b715d9913","r":"6391984:6902824:203:5097070","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6391984","6902824","203"],"w":["leaf",0]},{"t":"Haveria uma corrida às lojas, mas as lojas talvez nem estivessem a funcionar.","e":"Your credit card's not going to work at the store. There'd be absolutely mass panic.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.428939,"version":"labse-cosine/v1"},"x":"68f26c386a24227c560c6959dd1d713b","i":"b30a9a9162e594b0f6ee7e120f2fc45f","r":"6493214:7029442:275:5147693","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6493214","7029442","275"],"w":["leaf",0]},{"t":"Há muitas lojas caras ao longo da avenida.","e":"There are many expensive shops along the avenue.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.905491,"version":"labse-cosine/v1"},"x":"1e908f9b2e4d990006a4a13fbec35c8d","i":"323faef7c5c5ae179dd399ac1c207188","r":"11312420:11312402","c":"carlosalberto","su":"https://tatoeba.org/en/sentences/show/11312420","ul":"https://tatoeba.org/en/sentences/show/11312420","b":"Tatoeba sentence #11312420 by carlosalberto; English translation #11312402 by carlosalberto","o":"https://tatoeba.org/en/sentences/show/11312420","tu":1,"w":["leaf",0]},{"t":"Também falaram com alguns donos de lojas na zona.","e":"Yeah, they also spoke to a couple other business owners in the area.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.774404,"version":"labse-cosine/v1"},"x":"b4887b770c9ce7f9fb676065d36a7f11","i":"dcb3c51a3031e4fcd49375824cb439c2","r":"5198026:6415437:560:2193669","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5198026","6415437","560"],"w":["leaf",0]},{"t":"Quando vou às lojas, é só isso que vendem.","e":"'Cause when you look in the stores here, that's all they sell.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.723254,"version":"labse-cosine/v1"},"x":"f7229f9b6754ac8ecc933307169ed95a","i":"a613538480a60c3b253f6befe65429c3","r":"5280330:6983108:307:4468447","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5280330","6983108","307"],"w":["leaf",0]},{"t":"Ela passou o tempo passeando entre as lojas.","e":"She killed time going around the shops.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.793497,"version":"labse-cosine/v1"},"x":"101be088d70f8bc5500cbdbc9be2e1ab","i":"a9f51c4c66965c3ba90abdcbc4374850","r":"998967:315924","c":"une_monica","su":"https://tatoeba.org/en/sentences/show/998967","ul":"https://tatoeba.org/en/sentences/show/998967","b":"Tatoeba sentence #998967 by une_monica; English translation #315924 by \\N","o":"https://tatoeba.org/en/sentences/show/998967","tu":1,"w":["leaf",0]},{"t":"Fazem ideia porque algumas lojas foram atacadas e outras não?","e":"Any idea why some shops were targeted and others were left alone?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.8011,"version":"labse-cosine/v1"},"x":"3ddeb97d50718009f68c23756faa4a84","i":"91941d01446cad897b58d4f8bd4575a8","r":"4981514:6875974:180:2054216","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4981514","6875974","180"],"w":["leaf",0]},{"t":"Estão por aí várias lojas que ainda não explorámos.","e":"There's tons of stores out there we haven't scavenged yet.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.824786,"version":"labse-cosine/v1"},"x":"15f08b0e25a2e25d94a1bf3794f90762","i":"41895b85009863e292bb4f4b900cf5a1","r":"5212384:6748911:493:3410488","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5212384","6748911","493"],"w":["leaf",0]},{"t":"Quero os nossos discos à venda em lojas para não-informáticos.","e":"I want our discs available beyond stores aimed at the computer crowd.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.769724,"version":"labse-cosine/v1"},"x":"4a3ea6f81a2ec98fba4093700aa2b37d","i":"e59a7561e578e3cb57e0ca0df27454f5","r":"5539282:6910880:246:3802913","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5539282","6910880","246"],"w":["leaf",0]},{"t":"Ou que possa ir a pé até as lojas para as suas necessidades diárias.","e":"Within walking distance of stores for his daily needs.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.679838,"version":"labse-cosine/v1"},"x":"267f8b35dcabb281a13985c42f416f0c","i":"98ee4f75c231a307f8aed50157a57943","r":"4941872:6368075:576:2012903","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4941872","6368075","576"],"w":["leaf",0]},{"t":"Hoje é feriado! Por isso todas as lojas estão fechadas.","e":"Today's a bank holiday! That's why all shops are closed.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.881265,"version":"labse-cosine/v1"},"x":"29abbde39e4079b1d091cdb9b651e5cf","i":"adac0828373ea2a07617aadbd43854df","r":"8835973:9283122","c":"Ricardo14","su":"https://tatoeba.org/en/sentences/show/8835973","ul":"https://tatoeba.org/en/sentences/show/8835973","b":"Tatoeba sentence #8835973 by Ricardo14; English translation #9283122 by Nylez","o":"https://tatoeba.org/en/sentences/show/8835973","tu":1,"w":["leaf",0]}]]},"ebd6f3fd":{"m":[[{"t":"Sabias que há histórias iguais a essa, em cada um destes livros?","e":"Well, did you know that there are stories just like that in every one of these books?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.854539,"version":"labse-cosine/v1"},"x":"bbd9be9440ef6280774f85e787f508dd","i":"08fa7b1e20e00db671c2e19b86742977","r":"5803094:6887550:326:4698057","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5803094","6887550","326"],"w":["leaf",0]},{"t":"Eu odeio as mulheres que dizem que todos os homens são iguais.","e":"I hate women who say that all men are alike.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.895119,"version":"labse-cosine/v1"},"x":"dbf9fcad8525780d84ff021346e438c7","i":"7846e3a2d3e517130211dacc83b575be","r":"9288010:8395521","c":"heo598","su":"https://tatoeba.org/en/sentences/show/9288010","ul":"https://tatoeba.org/en/sentences/show/9288010","b":"Tatoeba sentence #9288010 by heo598; English translation #8395521 by abburns","o":"https://tatoeba.org/en/sentences/show/9288010","tu":1,"w":["leaf",0]},{"t":"São 12 peças destas e são iguais em todo o lado.","e":"It's a dozen of these. They are consistent in appearance across manufacturers.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.506933,"version":"labse-cosine/v1"},"x":"bb481a0a26205f8e9a6a434416796c87","i":"b3691234dc0ce411e3f67fa912c749de","r":"3853924:6358542:35:633282","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3853924","6358542","35"],"w":["leaf",0]},{"t":"Todos os animais são iguais, mas alguns são mais iguais do que outros.","e":"All animals are equal, but some animals are more equal than others.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.87692,"version":"labse-cosine/v1"},"x":"124c4dde024542cb3663d97547fdefb4","i":"c6020fadee50dd5bea72d337e23d0950","r":"942758:393812","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/942758","ul":"https://tatoeba.org/en/sentences/show/942758","b":"Tatoeba sentence #942758 by alexmarcelo; English translation #393812 by blay_paul","o":"https://tatoeba.org/en/sentences/show/942758","tu":1,"w":["leaf",0]},{"t":"Cortar um bolo em pedaços iguais é bem difícil.","e":"Cutting a cake into equal pieces is rather difficult.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.878507,"version":"labse-cosine/v1"},"x":"a4fd4f1eca8100c8b4fbb5ee4ba781b7","i":"2a7a91d567a383849297276aa53f6768","r":"1322830:976009","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/1322830","ul":"https://tatoeba.org/en/sentences/show/1322830","b":"Tatoeba sentence #1322830 by alexmarcelo; English translation #976009 by CM","o":"https://tatoeba.org/en/sentences/show/1322830","tu":1,"w":["leaf",0]},{"t":"São as pessoas que se mudam, ou então ficam iguais.","e":"People change themselves or they don't.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.763952,"version":"labse-cosine/v1"},"x":"7b017e28ad092d277bc11f9e827de210","i":"50ab1875ac5faadc6737304703c4a1bf","r":"4307670:6670430:131:2658766","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4307670","6670430","131"],"w":["leaf",0]},{"t":"Eu sei que para vocês, nós parecemos todos iguais.","e":"I know we all look alike to you.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.903077,"version":"labse-cosine/v1"},"x":"2bdb7cd00f69b8ba868e2b01bc87c328","i":"705005a9b9f4054490435e37024e87fe","r":"3781964:6107543:172:570323","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3781964","6107543","172"],"w":["leaf",0]},{"t":"Estas camisas são iguais. Elas são da mesma cor.","e":"These shirts are the same. They are the same colour.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.902617,"version":"labse-cosine/v1"},"x":"9173f4f47a1dc6d96c0f79d60d15087f","i":"62b6bc7ed2cbff563f6deaa8ecb18611","r":"956903:463136","c":"une_monica","su":"https://tatoeba.org/en/sentences/show/956903","ul":"https://tatoeba.org/en/sentences/show/956903","b":"Tatoeba sentence #956903 by une_monica; English translation #463136 by lukaszpp","o":"https://tatoeba.org/en/sentences/show/956903","tu":1,"w":["leaf",0]}]]}}}