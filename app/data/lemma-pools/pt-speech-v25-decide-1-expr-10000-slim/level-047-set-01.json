147"],"w":["leaf",0]}],[{"t":"Deve ser esquisito sentir que me estás a trair com ele.","e":"It must be really weird feeling like you're cheating on me with him.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.88455,"version":"labse-cosine/v1"},"x":"7ddf09adc980ce2460f081e5e4be0e9e","i":"73ad2770270efbfca3cb47ef4732e83d","r":"4932662:6589169:408:3094525","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4932662","6589169","408"],"w":["leaf",0]},{"t":"Não me vai trair com a minha vizinha porque não pode.","e":"He won't cheat on me with my neighbor 'cause he can't.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.848213,"version":"labse-cosine/v1"},"x":"560a30ac832d3b761fb8907c0ad97759","i":"c2f55f5a3aefcb510d4a88034f6d2fc2","r":"6201156:6986110:441:4962618","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6201156","6986110","441"],"w":["leaf",0]}]]},"ea09f7e6":{"m":[[{"t":"Eu traí um amigo, menti sobre quem eu sou.","e":"I betrayed a friend, lied about who I am.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.861821,"version":"labse-cosine/v1"},"x":"ec7b842fba00f16391edf3727fc6c925","i":"0db34994cacad643dc7d9424ee9967c3","r":"1542768:6793568:330:2250248","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1542768","6793568","330"],"w":["leaf",0]},{"t":"Traí as pessoas que me eram mais próximas.","e":"I've betrayed the people closest to me.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.756178,"version":"labse-cosine/v1"},"x":"fb8aa6d97d5102f59c5107eb5b2d2c5f","i":"5c61830ad35094995eea2eb801fc469b","r":"4540710:6973542:1957:2774935","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4540710","6973542","1957"],"w":["leaf",0]},{"t":"Acho que te traí e não era a minha intenção.","e":"I think I fucked you over, but I did not mean to fuck you over.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.691308,"version":"la