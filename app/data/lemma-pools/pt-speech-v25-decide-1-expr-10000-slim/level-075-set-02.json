les-v2018.php","d":["3654680","6898119","247"],"w":["leaf",0]},{"t":"Serei directa: proponho um acordo para o meu petróleo.","e":"I'll get right to the point. I want to offer you a deal on my oil.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.699671,"version":"labse-cosine/v1"},"x":"8cdf0983a540568c464afb5b4eb31134","i":"e3055e202f6d2048ac0ed025c821f1bc","r":"6131028:7017904:211:4907721","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6131028","7017904","211"],"w":["leaf",0]},{"t":"Portanto... de hoje em diante... proponho... aceitar os ensinamentos do Feiticeiro.","e":"So... from this day forward... I propose... we embrace the teachings of The Wizard.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.902431,"version":"labse-cosine/v1"},"x":"0f01482785ca5e7a592905d2cf7597b7","i":"e4fa913c3b84ceef64f6aa2be62be4e3","r":"4897612:6867069:563:4431146","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4897612","6867069","563"],"w":["leaf",0]},{"t":"Proponho uma trégua, para proteger aqueles que nos restam.","e":"I propose a truce... To protect the people we have left.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.799269,"version":"labse-cosine/v1"},"x":"7f7ac09878fb0e08fffdf5049b074883","i":"2d89b89b7a626054b28366954b185e3e","r":"4396814:6104498:679:1440527","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4396814","6104498","679"],"w":["leaf",0]},{"t":"Então, proponho que fiquemos acordados e esperemos pelos jornais da manhã juntos.","e":"Then I propose we stay up all night and wait of the morning paper together.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.859339,"version":"labse-cosine/v1"},"x":"c7a6a2812b8d9280507ffed2f880f5c2","i":"e0edf45ae7a4b01bbc2c90433a275de6","r":"4543900:6655839:189:1676067","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4543900","6655839","189"],"w":["leaf",0]},{"t":"O que eu proponho é uma abertur