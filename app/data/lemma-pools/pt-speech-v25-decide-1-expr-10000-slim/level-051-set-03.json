8.php","d":["2345759","7056959","1147"],"w":["leaf",0]},{"t":"Acho que foi uma traição, uma emboscada de um aliado.","e":"Uh, I think it might have been a betrayal. Ambush by an ally.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.81736,"version":"labse-cosine/v1"},"x":"6d0d59f8472a94ebc80aad43fca57575","i":"120fe687cc49b4b2640837229b7c2df2","r":"5280540:6988647:87:3540152","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5280540","6988647","87"],"w":["leaf",0]},{"t":"Em busca de um aliado, talvez, para ameaçar a minha posição de Capitão.","e":"Seeking an ally, perhaps, to threaten my position as captain.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.877205,"version":"labse-cosine/v1"},"x":"c589252e7dd3ff31e314424c23405615","i":"241c8e76255febcae6b803a1682fd7d8","r":"3600856:6026778:387:443530","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3600856","6026778","387"],"w":["leaf",0]},{"t":"É o nosso aliado mais antigo e forte.","e":"It's our oldest, strongest ally.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.874295,"version":"labse-cosine/v1"},"x":"1cdee322dfcfcfd75019188991143a0e","i":"38bff106682147bf32f4ad8de4b09c8b","r":"3300542:6689340:151:2422476","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3300542","6689340","151"],"w":["leaf",0]},{"t":"O Falcão Nocturno é um aliado necessário, não um amigo.","e":"Nighthawk is a necessary ally, not a friend.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.882378,"version":"labse-cosine/v1"},"x":"ea005dad97bb95f3fa341c802a1e7091","i":"62532305298c3d560038c985d254ae9f","r":"4772016:6297780:280:1882073","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4772016","6297780","280"],"w":["leaf",0]},{"t":"O inimigo de um inimigo não necessariamente é um aliado.","e":"An enemy of an enemy is not necessarily an ally.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.874361,"version":"labse-cosine/v1"},"x":"bbe8fdea2a43ca51c7b5a1841bb75a46","i":"91a72ea407bcd13f90759a32d9b1d9ba","r":"4814974:3010102","c":"Ricardo14","su":"https://tatoeba.org/en/sentences/show/4814974","ul":"https://tatoeba.org/en/sentences/show/4814974","b":"Tatoeba sentence #4814974 by Ricardo14; English translation #3010102 by CK","o":"https://tatoeba.org/en/sentences/show/4814974","tu":1,"w":["leaf",0]},{"t":"Você sabe que sou o seu aliado aqui.","e":"You know that I'm your ally here.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.924218,"version":"labse-cosine/v1"},"x":"5844d2ccdc8c4607130d9afce1496729","i":"a3e4513bfe1343a1dc07ffff11b0ed9c","r":"4928536:6378858:141:1998324","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4928536","6378858","141"],"w":["leaf",0]},{"t":"Depois disso, como aliado do meu inimigo, passas a ser meu inimigo.","e":"After that, as the ally of my enemy, you are my enemy.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.815045,"version":"labse-cosine/v1"},"x":"d5e216aa6f88d433a89dc12f418185c7","i":"d640b74b26118e3659746a5dcd637789","r":"6134090:6937718:301:4909775","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6134090","6937718","301"],"w":["leaf",0]},{"t":"Mas gostava que soubesse que pode contar comigo como aliado.","e":"But I just wanted you to know that you can count on me as an ally.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.816861,"version":"labse-cosine/v1"},"x":"5b6a0d0560a6a0202063d5973e3728da","i":"ef4267ffd2b79cb080360a13638697bd","r":"3746298:6309556:223:538239","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3746298","6309556","223"],"w":["leaf",0]},{"t":"- Sou um bom aliado e um homem de negócios.","e":"- I'm a good ally and a businessman.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.896947,"version":"labse-cosine/v1"},"x":"f0da15ea06a20015b8e241db202e8c8a","i":"f9f83bff8cb143a3ed