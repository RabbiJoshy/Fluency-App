"labse-cosine/v1"},"x":"8ddf2419fb629a5cdb5416e1828a4df1","i":"2f816a0d12bf88d226785d809f71d43d","r":"5095274:6797897:484:3246725","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5095274","6797897","484"],"w":["leaf",0]},{"t":"Vamos fazer isso de uma forma que esperamos ser apropriada.","e":"We will do that in what we hope is an appropriate fashion.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.887877,"version":"labse-cosine/v1"},"x":"96a38a69f15a7477666262ed48521dab","i":"37e9c1de96debefc499c6b890e8020c9","r":"4277098:6735722:250:2642377","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4277098","6735722","250"],"w":["leaf",0]},{"t":"Não me parece que seja altura apropriada para conversar.","e":"I don't think this is an appropriate time to talk.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.922831,"version":"labse-cosine/v1"},"x":"04457176773f360d55bbf65595c57161","i":"3a9fdcd136504ff77eb558d9f42f397c","r":"4481414:7038844:435:4403103","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4481414","7038844","435"],"w":["leaf",0]},{"t":"A esquadra tem de ser apropriada para crianças.","e":"We got to make this place kid-friendly.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.587817,"version":"labse-cosine/v1"},"x":"61d2f1119f13b01db96f81b5433aa52a","i":"4d7c8038b28a984057e105c109078046","r":"4526688:6483876:82:1659556","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4526688","6483876","82"],"w":["leaf",0]},{"t":"Eles também deviam de se comportar de forma apropriada à idade.","e":"They should also behave in a manner appropriate to their years.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.821615,"version":"labse-cosine/v1"},"x":"fe16b6dfdb628e4131327e2026d95ad7","i":"5f6940ad380dbc9907cb06dad038d1a0","r":"1703957:6841001:372:2266867","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1703957","6841001","372"],"w":["leaf",0]},{"t":"Parece ser mais apropriada para o assunto do que eu.","e":"You seem more cut out for this than me.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.715283,"version":"labse-cosine/v1"},"x":"da50842ea83aa17f96bce5d8240eecac","i":"620dbe48a01bae8fb49463652e07da9a","r":"5355262:6504241:243:3616997","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5355262","6504241","243"],"w":["leaf",0]},{"t":"Ela é a pessoa apropriada para nos liderar.","e":"She is the proper person to lead us.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.889935,"version":"labse-cosine/v1"},"x":"123b9bf2ac0c6bd3962ca926eebe74a2","i":"86f81e8850c7acc5c7b6614db46a481e","r":"5584096:6775886:593:3862721","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5584096","6775886","593"],"w":["leaf",0]},{"t":"Nunca há uma hora apropriada, para a nossa morte.","e":"There is never a convenient time for any of us to die.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.793852,"version":"labse-cosine/v1"},"x":"8b6337887db1c623689515e529f4c7ac","i":"96b45e38cc8ce9505042eed7b3a6bc2f","r":"3687310:6771189:6:493369","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3687310","6771189","6"],"w":["leaf",0]},{"t":"- Foi mais uma suspensão por não usar roupa apropriada no trabalho.","e":"Oh, it was, um, more like a suspension pending my agreement to work-appropriate undergarments.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.622884,"version":"labse-cosine/v1"},"x":"da04c72ada74f8e54a7dbdca41bc1d7d","i":"4eae78877443a306ba9b5addcecd13e8","r":"5354636:6510046:239:3616307","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5354636","6510046","239"],"w":["leaf",0]}]]},"76050234":{"m":[[],[{"t":"O saco do lixo irá conter os miolos.","e":"Trash bag will collect the brains.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.74005,"version":"labse-cosine/v1"},"x":"7f6b351ece49494266bc7f4d4f1f1c29","i":"26560881600e7b3ac6676f954d7e4cc3","r":"5236142:6702182:330:3461150","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5236142","6702182","330"],"w":["leaf",0]}]]},"7c144b98":{"m":[[{"t":"Como é que se atreve a comparar as suas cicatrizes com as minhas? !","e":"How dare you compare your scars to mine?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.879025,"version":"labse-cosine/v1"},"x":"1bb53320de8fa797d78ce2b9e1a72483","i":"43bf1155c8c7508734b0014304ba0ea0","r":"4122454:6753780:739 740:923362","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4122454","6753780","739 740"],"w":["leaf",0]},{"t":"Achamos que as cicatrizes são um mapa que nunca podemos perder.","e":"We figure the scars are a map we can never lose.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.898169,"version":"labse-cosine/v1"},"x":"e7fc99f1b769bbcd1c46a6717ebf3d11","i":"64404856bf10ca6d45b6dca09c99bcde","r":"4684732:6828038:39:2883759","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4684732","6828038","39"],"w":["leaf",0]},{"t":"E tenho cicatrizes de batalha para demonstrar que estou preparada.","e":"And I've got the battle scars to prove I'm up for it.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.871042,"version":"labse-cosine/v1"},"x":"0bda495db8929d15317c00dc165f928d","i":"d8f2a8b418bfc10390dfb02e93456113","r":"4724478:6370842:274:1853501","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4724478","6370842","274"],"w":["leaf",0]},{"t":"Ou o teu barbeiro esconde as tuas cicatrizes?","e":"Or does your hairdresser here hide all your scars for you?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.769917,"version":"labse-cosine/v1"},"x":"bf64761a675b52a6c33bd99aae411be1","i":"ddb8847822693d70449506b1d0241786","r":"4430766:6555374:191:2713457","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4430766","6555374","191"],"w":["leaf",0]},{"t":"Se você me ensinar como dançar, eu te mostrarei minhas cicatrizes escondidas.","e":"If you teach me how to dance, I will show you my hidden scars.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.804913,"version":"labse-cosine/v1"},"x":"e0ad8f9ee0d99f43683bbef666736ca7","i":"c8cbf3ae50c271447b3c7ef5690f541e","r":"418195:2185","c":"brauliobezerra","su":"https://tatoeba.org/en/sentences/show/418195","ul":"https://tatoeba.org/en/sentences/show/418195","b":"Tatoeba sentence #418195 by brauliobezerra; English translation #2185 by kebukebu","o":"https://tatoeba.org/en/sentences/show/418195","tu":1,"w":["leaf",0]},{"t":"Porque ainda tenho cicatrizes com cheiro a baunilha.","e":"'Cause I still have the vanilla-scented scars from that.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.808749,"version":"labse-cosine/v1"},"x":"3b4f044073ea0c525f84aa4f40458e0a","i":"e8d9994954159855b053e167852a8e63","r":"4364912:6505826:224:1372449","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4364912","6505826","224"],"w":["leaf",0]},{"t":"Imagina todas as cicatrizes emocionais que ela tem.","e":"Imagine all of the emotional scars she has.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.871682,"version":"labse-cosine/v1"},"x":"a06ae9d95ce10ffb7c2572ecc4c4d255","i":"d742e3a1b91bee4f57e9c06b98ac5292","r":"5586424:6609878:501:3886918","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5586424","6609878","501"],"w":["leaf",0]},{"t":"Cicatrizes não são nada para o Senhor da Luz.","e":"Those scars mean nothing to the Lord of Light.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.705779,"version":"labse-cosine/v1"},"x":"1bd90059157a86ee1ac5fb539843e27b","i":"279f4625e227a13b5fc70103d984dbeb","r":"3866838:6119431:189:654016","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3866838","6119431","189"],"w":["leaf",0]},{"t":"Até as nossas mulheres. A minha filha ainda tem as cicatrizes.","e":"To our women... my daughter still bears the scars.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.859661,"version":"labse-cosine/v1"},"x":"56a3643e4f61553f2ee30f1b250bf25d","i":"32cac50fc2121baaf97416a7ae4d2f32","r":"6119882:6970979:338 339:4225922","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6119882","6970979","338 339"],"w":["leaf",0]},{"t":"Ambos membros do mesmo gangue. Ambos com ferimentos de faca e cicatrizes.","e":"Both members of the same gang, both carrying knife wounds and scars.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.857634,"version":"labse-cosine/v1"},"x":"a684aabb65a59500605a262814afd694","i":"87ecc11f02e3847906504a9f2f542ec0","r":"4194594:7065558:591 592:1071399","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4194594","7065558","591 592"],"w":["leaf",0]},{"t":"Cicatrizes não são o problema doutor. Eu não sou bonito faz muito tempo.","e":"Scars are no big deal, Doctor. I haven't been pretty for a very long time.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.83912,"version":"labse-cosine/v1"},"x":"f09012212067b780e72dd6987b00b0b1","i":"92e6a92e87c455da3a09f49550ff99ad","r":"2084070:2083180","c":"MarlonX19","su":"https://tatoeba.org/en/sentences/show/2084070","ul":"https://tatoeba.org/en/sentences/show/2084070","b":"Tatoeba sentence #2084070 by MarlonX19; English translation #2083180 by halfb1t","o":"https://tatoeba.org/en/sentences/show/2084070","tu":1,"w":["leaf",0]},{"t":"As batalhas deixam cicatrizes. Algumas podes não ver.","e":"Battles leave scars, some you can't see.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.890412,"version":"labse-cosine/v1"},"x":"6133a939f854743f055a4fdd41eb4b91","i":"416d69b43e297a9a47fdba471cf8a6fd","r":"6050876:6873632:28 29:4180110","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6050876","6873632","28 29"],"w":["leaf",0]}]]}}}