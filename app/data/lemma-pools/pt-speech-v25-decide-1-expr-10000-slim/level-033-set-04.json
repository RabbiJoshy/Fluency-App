b","r":"4307670:6670430:573:2659185","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4307670","6670430","573"],"w":["leaf",0]},{"t":"Ele quer encontrar vocês na sala de conferências em cinco minutos.","e":"He wants to meet you in the conference room in five.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.835283,"version":"labse-cosine/v1"},"x":"87e406317117f2a8abb0029ceb6364a9","i":"b9e38d3c28ca8b18160f1036a81e9d3b","r":"4871980:6851268:352:3052248","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4871980","6851268","352"],"w":["leaf",0]},{"t":"Tirando as cem que estão na outra sala de conferências.","e":"Except for the 100 in the other conference room.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.852104,"version":"labse-cosine/v1"},"x":"100d23b3981dd7bf5225f9bd237843e1","i":"c8873e0fdc73bd483239c855456fb523","r":"5181368:6654459:172:3343594","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5181368","6654459","172"],"w":["leaf",0]},{"t":"Já agora, estás na sala de conferências errada.","e":"By the way, you're in the wrong conference room.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.821811,"version":"labse-cosine/v1"},"x":"08f7503cebd21604da179d3b85016454","i":"dd0b0dfca10b974894e893066c42036b","r":"4800888:6654450:92:1903361","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4800888","6654450","92"],"w":["leaf",0]},{"t":"Lamento por isto, a sala de conferências foi reservada.","e":"Sorry about that. Conference room was booked. So, you want to tell us about your wife","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.622183,"version":"labse-cosine/v1"},"x":"13668aab1e2c10b340d7ad4e43a4199b","i":"29f565a435bc150f98bda6bee49b8676","r":"5526040:6803438:250:3781033","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5526040","6803438","250"],"w":["leaf",0]}],[{"t":"Não houve conferências para ti, quando fui presa.","e":"Di