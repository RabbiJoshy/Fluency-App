":"sentence-transformers/LaBSE","score":0.777625,"version":"labse-cosine/v1"},"x":"e1cc37451380610d56a3778eb7641df7","i":"c25d370276516ae00c41247e2f025386","r":"6318450:6955277:429:4280025","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6318450","6955277","429"],"w":["leaf",0]},{"t":"A minha preocupação é pôr os foguetes no ar, não onde caem.","e":"My concern is whether the rockets go up, not where they come down.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.781993,"version":"labse-cosine/v1"},"x":"871c09fdba7d6dbfe5c45277a916c423","i":"c8eb8189af5a6dacd4354c243835d25a","r":"6046814:6852095:510:4177138","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6046814","6852095","510"],"w":["leaf",0]},{"t":"É por causa dela que disparam foguetes contra ti?","e":"Is she the reason rockets keep getting dropped on your head?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.774826,"version":"labse-cosine/v1"},"x":"30bcaab0c1634331a5be034d888f3edc","i":"35fbaf70ab24e84f949b5f5da1499b87","r":"4179642:6750759:239:2602555","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4179642","6750759","239"],"w":["leaf",0]},{"t":"É óbvio que os foguetes nas pontas são instáveis.","e":"Clearly corner rockets are totally unstable.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.706482,"version":"labse-cosine/v1"},"x":"a58910822ffcb3251edffbf54b8d3572","i":"541cf0aff7afe331bfa04cc1f2687dad","r":"6318450:6955277:458:4280051","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6318450","6955277","458"],"w":["leaf",0]},{"t":"Vou trabalhar com isto. São modelos básicos de foguetes.","e":"This is what I'm working with, they're just basic model rockets.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.831036,"version":"labse-cosine/v1"},"x":"86cc0f7f865c4a0866a528461c2c241f","i":"9a3e64a6babc1b936dc4df6c95d3fa7e","r":"6318450:6955277:417 418:4280015","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6318450","6955277","417 418"],"w":["leaf",0]},{"t":"Foguetes confirmados. A montar uma boa separação dos foguetes.","e":"Mr. Officer, confirm staging a good solid rocket booster separation.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.621619,"version":"labse-cosine/v1"},"x":"31860a5212276b612a6ef04cc1b7453c","i":"b03c3903cf33e4e58b8170c9513ffb2b","r":"3899796:6708896:1282 1283:694499","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3899796","6708896","1282 1283"],"w":["leaf",0]}]]},"87512ec6":{"m":[[{"t":"Disse que alguém deu um tiro ao marido e que depois se suicidou.","e":"She said someone shot her husband and then killed himself.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.88759,"version":"labse-cosine/v1"},"x":"8a7edeba22f93dd3fc4d4153b0c71da4","i":"33e07b507b0536f454eac46f5cedc5a7","r":"6034600:7024312:112:4865530","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6034600","7024312","112"],"w":["leaf",0]},{"t":"Sim, ouvi dizer que o legista disse que ele se suicidou.","e":"Yeah, I heard the coroner calling Boone's death a suicide.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.67962,"version":"labse-cosine/v1"},"x":"e4842a9219ac9b439cba9198f4450fc8","i":"5ad12fc7d8b7d73620e50d0bb0419507","r":"4381308:6362437:126:1411057","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4381308","6362437","126"],"w":["leaf",0]},{"t":"Estás a dizer que ele não se suicidou?","e":"You saying he didn't kill himself?","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.943493,"version":"labse-cosine/v1"},"x":"c402bb91857979da1077bb6605408ffe","i":"e073ff413b40f399a554aa0831d6e00e","r":"5538538:6717191:364:3798404","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5538538","6717191","364"],"w":["leaf",0]},{"t":"E que a tua mãe se suicidou porque já não aguentava mais.","e":"And that your mother killed herself because she couldn't take it anymore.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.884184,"version":"labse-cosine/v1"},"x":"9b620a5458b6ff6bc1fd36d8e0a6ac8d","i":"bff1f06e3a91eb9989091c1b5e6f4ed5","r":"3319920:6478162:1329:339536","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3319920","6478162","1329"],"w":["leaf",0]},{"t":"Dizem que morreu ao cair de um cavalo, mas eu acho que se suicidou.","e":"They say he was killed falling off a horse, but I think it was suicide.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.886716,"version":"labse-cosine/v1"},"x":"11e97e312fd2f7eee101c18e0a2452f3","i":"e748f486d41e02570fcb0b142bd93791","r":"5479616:7041149:897:4514031","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5479616","7041149","897"],"w":["leaf",0]},{"t":"Ele suicidou-se ontem com um tiro na cabeça.","e":"He shot himself in the head yesterday.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.81645,"version":"labse-cosine/v1"},"x":"62153b6d7bf4782759415ec8c2783415","i":"3303f3b8e017173533adec94ff13bea4","r":"6520942:6945927:705:5163651","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6520942","6945927","705"],"w":["leaf",0]},{"t":"Se eles disseram isso porque não queriam dizer que ela se suicidou, não faço ideia.","e":"Whether they reported that because they didn't want to say she committed suicide, I have no idea.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.796905,"version":"labse-cosine/v1"},"x":"3ab22a64377e4cd23174d4cb5cd06f51","i":"0f0b868dd5b590657f0c5772922db561","r":"4485260:6166170:62:1569643","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4485260","6166170","62"],"w":["leaf",0]},{"t":"- A minha mãe não se suicidou, foi um acidente.","e":"- My mom didn't kill herself, it was an accident.","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.954123,"version":"labse-cosine/v1"},"x":"6900a3efda55647bf997ee7e3c504bb9","i":"032d4a90dd29b43a2f3012ebfffc5af0","r":"6010518:6899913:917:4149695","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6010518","6899913","917"],"w":["leaf",0]},{"t":"Não tenho nenhuma dúvida de que Tom não se suicidou.","e":"There is no doubt in my mind that Tom didn't commit suicide.","s":"tatoeba","ta":{"model":"sentence-transformers/LaBSE","score":0.839561,"version":"labse-cosine/v1"},"x":"08ab25ba2107351352d75b01d1220db1","i":"232bcd38b38f800d9471b2fd866e4f77","r":"5482672:1096061","c":"ToinhoAlam","su":"https://tatoeba.org/en/sentences/show/5482672","ul":"https://tatoeba.org/en/sentences/show/5482672","b":"Tatoeba sentence #5482672 by ToinhoAlam; English translation #1096061 by CK","o":"https://tatoeba.org/en/sentences/show/5482672","tu":1,"w":["leaf",0]}]]}}}