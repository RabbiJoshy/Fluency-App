ac37c846a","i":"98b87c9157a075e13b5e80f822701c37","r":"2436682:6673557:636:2328893","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2436682","6673557","636"],"w":["leaf",0]},{"t":"És mesmo doce como o vinho E tão divina","e":"You truly are as fine as wine And so divine","s":"opensubtitles","ta":{"model":"sentence-transformers/LaBSE","score":0.862238,"version":"labse-cosine/v1"},"x":"bfc75aa602126d441a99f27641ca3016","i":"1b8f9731a9955b399f4d4adc38d4ef52","r":"4611880:6709812:1301:2813907","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4611880","6709812","1301"],"w":["leaf",0]}]]}}}