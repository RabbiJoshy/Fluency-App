ansar","pos":"VERB","source_reference":"spanishdict-menu:descansar:582d0","translation":"to rest","context":"agriculture"}]},"cec5ecdd":{"word":"mereces","rank":3587,"meanings":[{"headword":"merecer","pos":"VERB","source_reference":"spanishdict-menu:merecer:60f","translation":"to deserve","context":"to merit"},{"headword":"merecerse","pos":"VERB","source_reference":"spanishdict-menu:merecerse:763","translation":"to deserve","context":"to merit"}]},"6fd91ae9":{"word":"merezco","rank":4210,"meanings":[{"headword":"merecer","pos":"VERB","source_reference":"spanishdict-menu:merecer:60f","translation":"to deserve","context":"to merit"},{"headword":"merecerse","pos":"VERB","source_reference":"spanishdict-menu:merecerse:763","translation":"to deserve","context":"to merit"}]},"3bddc92a":{"word":"merecía","rank":5319,"meanings":[{"headword":"merecer","pos":"VERB","source_reference":"spanishdict-menu:merecer:60f","translation":"to deserve","context":"to merit"},{"headword":"merecerse","pos":"VERB","source_reference":"spanishdict-menu:merecerse:763","translation":"to deserve","context":"to merit"}]},"dc19f1dc":{"word":"merecen","rank":5384,"meanings":[{"headword":"merecer","pos":"VERB","source_reference":"spanishdict-menu:merecer:60f","translation":"to deserve","context":"to merit"},{"headword":"merecer","pos":"VERB","source_reference":"spanishdict-menu:merecer:c12","translation":"to be worth","context":"to merit"},{"headword":"merecerse","pos":"VERB","source_reference":"spanishdict-menu:merecerse:763","translation":"to deserve","context":"to merit"}]},"1cacb728":{"word":"mapas","rank":7520,"meanings":[{"headword":"mapa","pos":"NOUN","source_reference":"spanishdict-menu:mapa:0b0","translation":"map","context":"cartography"}]}},"examples":{"aaddeaf7":{"m":[[{"t":"La cama es el último lugar en el que esa mujer descansa algo.","e":"Bed is the last place that woman gets any rest.","s":"opensubtitles","x":"74f1903d0c468f6ea73b97eba540c377","i":"1095a045734e886df86a25505d25aaf1","r":"5720478:6952111:454:3393968","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5720478","6952111","454"],"w":["tuple",0]},{"t":"Nuestro destino descansa en las manos de un niño.","e":"Our fate rests in the hands of one child.","s":"opensubtitles","x":"fae83332b165778e5d76d718c726366b","i":"778a58083640c593e28b92b3b226f113","r":"4768656:6862792:1054:1044339","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4768656","6862792","1054"],"w":["tuple",0]},{"t":"De 5 a 6.30 se sirve la cena y se descansa.","e":"5 to 6.30 is dinner and rest.","s":"opensubtitles","x":"e7bb69221d64cc44a245a4c842cb7aa1","i":"a9605d3cc4145c3db0f087657cb09e22","r":"4516232:6831482:89:755295","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4516232","6831482","89"],"w":["tuple",0]},{"t":"Ve a casa y descansa, pero regresa pronto.","e":"Go home and get some rest, but come back soon.","s":"opensubtitles","x":"2104b200d7e33dbd62801f599ba14c4a","i":"d9d56cafe1f2b19b8be8eab7ead9427e","r":"5011946:6725668:90:1349320","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5011946","6725668","90"],"w":["tuple",0]},{"t":"Vete a casa, descansa, pero duerme pegado al teléfono.","e":"- Go home, get some rest, but sleep by your phone.","s":"opensubtitles","x":"d1eb1faaa4e23fdbeda3c6674fe2f233","i":"31a882d3d2e1646c06e3e98172d8cb39","r":"6326286:6958044:702:3929201","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6326286","6958044","702"],"w":["tuple",0]},{"t":"Tres hombres saben dónde descansa el cofre, y una mujer.","e":"Three men know the resting place of the chest, and one woman.","s":"opensubtitles","x":"cafa41e552a871daeefd6161cb4e8aa9","i":"c745c6ff1b70e89b26b37d3f81a624c5","r":"4906428:6876440:475:3091688","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4906428","6876440","475"],"w":["tuple",0]},{"t":"\"Calma tu mente, descansa su pesado corazón viejo, porque estoy aquí para salvarte\".","e":"\"Calm your racing mind, rest your weary heart, old man, because I'm here to save you.\"","s":"opensubtitles","x":"eb41190cea4c31d1f660234b93a6a534","i":"5a2b721a207eadb1aff7b4a6c7cf1e75","r":"4948870:6449629:517:1267153","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4948870","6449629","517"],"w":["tuple",0]},{"t":"Deja la bebida y descansa un poco.","e":"You lay off the booze and get some rest.","s":"opensubtitles","x":"821ad018dca10df334334977382244d3","i":"1be2c74e1dd4bc7acc55cda36067afd3","r":"6660936:6939774:187:4140599","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6660936","6939774","187"],"w":["tuple",0]}],[]]},"cc4edec6":{"m":[[{"t":"No, simplemente pienso que es buena idea que descanse.","e":"No, I just think it might be a good idea to get some rest.","s":"opensubtitles","x":"65453a0e6bea2016be63833dfa8d19b8","i":"2a083bee2b06802ccaf7f03182083ef3","r":"5915404:7014394:578:2583507","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5915404","7014394","578"],"w":["tuple",0]},{"t":"Y Ud. descanse ya un poco, ¿de acuerdo?","e":"And you get some rest, okay?","s":"opensubtitles","x":"178fe5a47d8641b9390d1b189c31b47c","i":"3df28dde22733c952b484885fbb66144","r":"2078718:6610721:347:101432","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2078718","6610721","347"],"w":["tuple",0]},{"t":"Como usted está cansado, sería mejor que descanse.","e":"As you are tired, you had better take a rest.","s":"tatoeba","x":"863c6fff1b8bae51681af07e5de4432a","i":"5eff5273b771373787351b465b86e4fc","r":"4641713:68978","c":"mervert1","su":"https://tatoeba.org/en/sentences/show/4641713","ul":"https://tatoeba.org/en/sentences/show/4641713","b":"Tatoeba sentence #4641713 by mervert1; English translation #68978 by Eldad","o":"https://tatoeba.org/en/sentences/show/4641713","tu":1,"w":["tuple",0]},{"t":"Sí, lo he mandado arriba para que descanse.","e":"Yeah, I sent him upstairs to rest.","s":"opensubtitles","x":"edaf1f40868b65f27f4cab42eed606a5","i":"76be65f34ff88ddc1f92d26fc6f75583","r":"5880476:6833288:354:2558426","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5880476","6833288","354"],"w":["tuple",0]},{"t":"Ahora mismo, ¿por qué no dejamos simplemente que descanse?","e":"Right now, why don't you just let him get some rest?","s":"opensubtitles","x":"7d7b9e61a9a9b48500164805b7364d0b","i":"8cba58105762ce6e5eb4328b598d9902","r":"5915450:7019751:340:3561539","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5915450","7019751","340"],"w":["tuple",0]},{"t":"Pero dice que la enfermera solo quiere que ella descanse.","e":"But he's saying that the nurse just wants her to get some rest.","s":"opensubtitles","x":"691473258877298a7d3e6609442eb925","i":"9ccd3c6ef11c330ae1ff4a81f9a5e076","r":"5797336:6904173:337:3453467","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5797336","6904173","337"],"w":["tuple",0]},{"t":"Todo el mundo descanse y estén listos para salir a primera hora.","e":"Everybody rest up and be ready to go at first light.","s":"opensubtitles","x":"48dd03f0bdee75b12177043bbf2efe00","i":"b8a8be97363ef87b271d596a30875780","r":"3007132:6866462:409:218592","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3007132","6866462","409"],"w":["tuple",0]},{"t":"Pero termine su té y descanse un poco.","e":"But finish your tea and get some rest.","s":"opensubtitles","x":"37694119a6f500cbd284ad22f2e43f49","i":"d0928bb7549019f4068d9f6ea40e24cd","r":"4706432:6499251:783:988818","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4706432","6499251","783"],"w":["tuple",0]}],[],[],[],[]]},"2831d047":{"m":[[{"t":"Solo estaba descansando mis ojos por un momento.","e":"I was just resting my eyes for a second.","s":"opensubtitles","x":"441a68fe519fb57dd7b9d9ab412751e1","i":"6f395424e51f44849836758e806ac9c8","r":"4871756:6539578:524:1184048","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4871756","6539578","524"],"w":["tuple",0]},{"t":"Ella está en casa descansando y preparando el examen.","e":"She's at home resting and preparing for the exam.","s":"tatoeba","x":"bd8526f929cf9bd967c2fa42f329727d","i":"9dab334aa0fa078dd412cdb766ea12b3","r":"1894025:531763","c":"zahurdias","su":"https://tatoeba.org/en/sentences/show/1894025","ul":"https://tatoeba.org/en/sentences/show/1894025","b":"Tatoeba sentence #1894025 by zahurdias; English translation #531763 by FeuDRenais","o":"https://tatoeba.org/en/sentences/show/1894025","tu":1,"w":["tuple",0]},{"t":"No, en serio, quiero decir, ¿estamos descansando o algo así?","e":"No, seriously, I mean, are we on a break or something?","s":"opensubtitles","x":"0acc5cc2d51b8c5775db88c208a0c863","i":"dee437c863698ec3ca05a8367b1b0a10","r":"5544892:6665941:32:2235577","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5544892","6665941","32"],"w":["tuple",0]},{"t":"Está descansando y centrándose en dirigir el país.","e":"He's resting and focusing on the business of running the country.","s":"opensubtitles","x":"0d3f59a9ab9911370226bcea954fc396","i":"1a64fc0efbf9379d095b97c4ee684f33","r":"6136698:6911665:213:3741870","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6136698","6911665","213"],"w":["tuple",0]},{"t":"Parece que has vuelto del hospital, descansando cómodamente.","e":"Looks like you're home from the hospital, resting comfortably.","s":"opensubtitles","x":"f526ea04e2a8adec979da2cd8290c959","i":"341990a2f1acb5e312eb2727f4c9cd2a","r":"5748102:6799447:486:2464720","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5748102","6799447","486"],"w":["tuple",0]},{"t":"Es importante que continúes descansando la voz, ¿entendido?","e":"It is important that you continue the voice rest, okay?","s":"opensubtitles","x":"74d858072a7f2e6fb32d0002e56f2073","i":"6c4dd584954a9760e32a9188a06f5876","r":"5134994:6505355:327:1495206","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5134994","6505355","327"],"w":["tuple",0]},{"t":"¿No se supone que deberías estar descansando?","e":"Aren't you supposed to be on bed rest?","s":"opensubtitles","x":"ca58e764508059592285c6eb27f2545a","i":"f05b593ece2e99f900fd9b1f0ca84885","r":"6148932:7008371:177:3767451","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6148932","7008371","177"],"w":["tuple",0]}],[]]},"54b268dd":{"m":[[{"t":"Tienen que dejar que descansen sus caballos, igual que nosotros.","e":"They have to rest their horses just like we do.","s":"opensubtitles","x":"9087045388ad5f61c277e8bf9dca2dc6","i":"8315f4bf556c20d3cb4d161a4a4ed679","r":"6358356:6959623:418:3960866","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6358356","6959623","418"],"w":["tuple",0]},{"t":"Simplemente descansen y relájense, tengo todo bajo control.","e":"You just kick back and relax; I've got it all under control.","s":"opensubtitles","x":"709086e51f4b7995b75a72f8451be159","i":"6c32109730dc10f21f86499e1637442c","r":"6255718:7032082:195:2829389","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6255718","7032082","195"],"w":["tuple",0]},{"t":"Descansen y hay un minibar con algo de comida.","e":"Get some rest, and there's a minibar with some food in it.","s":"opensubtitles","x":"25cfffcd8c76006214f969bad4289e17","i":"c5f6e30a82a206f12ce7d44a12c8733d","r":"1594972:6583245:720:43130","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1594972","6583245","720"],"w":["tuple",0]},{"t":"Descansen bien antes de la diversión de mañana.","e":"Well, better rest up for all the fun we're going to have tomorrow.","s":"opensubtitles","x":"691566dec319d67575f7278c4634486f","i":"f39436bcdea7224bd4fc534e6c894f3b","r":"6751564:7006922:144:4183993","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6751564","7006922","144"],"w":["tuple",0]},{"t":"Les sugiero que descansen un poco, visiten a sus familias y se preparen.","e":"I suggest you all get some rest, visit with family, and prepare yourselves.","s":"opensubtitles","x":"cc7cc46e57738c693ed575637067c295","i":"1e70d60ab7cbe3cafc95b6294197fc9c","r":"5293640:7068490:427:3160068","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5293640","7068490","427"],"w":["tuple",0]},{"t":"Descansen, hay que caminar mucho mañana.","e":"- We should get some rest. We got a lot of ground to cover tomorrow.","s":"opensubtitles","x":"d92b7b52247092df7d320ff9cee12cc0","i":"4af6c5889c61e99493e7f63bac71892a","r":"1540011:6830299:491:36635","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1540011","6830299","491"],"w":["tuple",0]},{"t":"De acuerdo, caballeros, descansen un poco.","e":"All right, gentlemen, get some rest.","s":"opensubtitles","x":"e00158bc8a166eec63e75488bac83efc","i":"a850e759424eb643386a248da93b81f4","r":"5584142:6765576:57:2292269","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5584142","6765576","57"],"w":["tuple",0]}],[],[]]},"cec5ecdd":{"m":[[{"t":"Perdí mi oportunidad de darte la vida que mereces.","e":"I missed my chance to give you the life you deserve.","s":"opensubtitles","x":"68628d06e97c523459f795a9b8be2fbe","i":"275873a32e2a218f4c1d2335c2c6e282","r":"5668370:6805177:780:2377621","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5668370","6805177","780"],"w":["tuple",0]},{"t":"Porque eres un buen hombre, mereces una segunda oportunidad.","e":"'Cause you're a good man, you deserve a second chance.","s":"opensubtitles","x":"e71cd489202d72f027aa303e1e6b11b6","i":"48e27ba0e6dc700cc68a0005f6687ac5","r":"2950418:6893263:1513:211511","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2950418","6893263","1513"],"w":["tuple",0]},{"t":"No mereces nada de lo que te hago.","e":"You don't deserve any of what I do to you.","s":"tatoeba","x":"f77433961a2ed9644b4250e6b2f7ff75","i":"4dec6596e72d97055654fbc396d16c8e","r":"1540530:1533166","c":"Chevere33","su":"https://tatoeba.org/en/sentences/show/1540530","ul":"https://tatoeba.org/en/sentences/show/1540530","b":"Tatoeba sentence #1540530 by Chevere33; English translation #1533166 by Chevere33","o":"https://tatoeba.org/en/sentences/show/1540530","tu":1,"w":["tuple",0]},{"t":"Mereces más que su castigo, el cual será... extremo.","e":"You deserve better than their punishment, which would be... extreme.","s":"opensubtitles","x":"4df3849c4d4c0c2c87e319be8f0d3c27","i":"c9e092481b38a99e05be50df56fbc6a1","r":"5140326:6541147:479:1499395","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5140326","6541147","479"],"w":["tuple",0]},{"t":"Siento que mereces un poco de claridad sobre lo que va a pasar.","e":"I feel like you deserve some clarity on what's about to happen.","s":"opensubtitles","x":"754da85bc54deaef38d9d6f2c191c0e4","i":"e52d954244de94c98b894988fe5e1597","r":"6113994:6785775:102:2743937","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6113994","6785775","102"],"w":["tuple",0]},{"t":"Te daré todo lo que mereces.","e":"I'll give you all that you deserve.","s":"tatoeba","x":"21e7799a87de3f1b3b281960c8b1fb4d","i":"c68805c41d938d0b8bc5a7d5ef51f135","r":"4437302:4437215","c":"duendebit","su":"https://tatoeba.org/en/sentences/show/4437302","ul":"https://tatoeba.org/en/sentences/show/4437302","b":"Tatoeba sentence #4437302 by duendebit; English translation #4437215 by Tom13","o":"https://tatoeba.org/en/sentences/show/4437302","tu":1,"w":["tuple",0]},{"t":"Mejor de lo que mereces.","e":"Better than you deserve.","s":"opensubtitles","x":"b4eceb8476e7826edb70225a6ce6a845","i":"0cd043c9c7e9ce96e97e060fb92a4048","r":"6250158:7018278:788:3878891","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6250158","7018278","788"],"w":["tuple",0]},{"t":"- Nunca seré el hermano que mereces.","e":"I can never be the brother you deserve.","s":"opensubtitles","x":"3cda214c33d0ff5ac0f311bbc2b6cae9","i":"10573628265d18e36697736d3b610dee","r":"5218026:6570607:218:1664388","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5218026","6570607","218"],"w":["tuple",0]}],[{"t":"No necesitas darme las gracias porque te mereces lo mejor.","e":"You do not need to thank me because you deserve all the best.","s":"tatoeba","x":"d3c39b599992dc5a60bf260a2af02171","i":"971c20300c532f75b6612cff35dd2eca","r":"10671394:3037765","c":"Shishir","su":"https://tatoeba.org/en/sentences/show/10671394","ul":"https://tatoeba.org/en/sentences/show/10671394","b":"Tatoeba sentence #10671394 by Shishir; English translation #3037765 by Ricardo14","o":"https://tatoeba.org/en/sentences/show/10671394","tu":1,"w":["leaf",1]},{"t":"Así que... te mereces a alguien digno de esa gracia.","e":"So... you deserve someone worthy of that grace.","s":"opensubtitles","x":"be6da655541cf9d195a2cad9685529bb","i":"e17b257c8c1fcc0321d18b4f15e53d4d","r":"5668582:6858880:894:3349456","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5668582","6858880","894"],"w":["leaf",1]},{"t":"Y el porqué te ayudé a conseguir este trabajo es porque te lo mereces.","e":"And why I helped you get this job is because you deserve it.","s":"opensubtitles","x":"1f6bdadae72bfe1955a895e6a57ce65e","i":"5e356f35fa92ae2f5a8ac1f58e25e762","r":"5563360:6802077:342:2255689","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5563360","6802077","342"],"w":["leaf",1]},{"t":"Podría ser genial y te lo mereces.","e":"It could be great, and you deserve that.","s":"opensubtitles","x":"1cec6601f324686d44022c4a444c6337","i":"8cc1275ea3aa318562685dfde952505d","r":"5447154:6808270:1935:2055526","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5447154","6808270","1935"],"w":["leaf",1]},{"t":"Y es exactamente lo que te mereces.","e":"And it is exactly what you deserve.","s":"opensubtitles","x":"0fa989990d2a064fb61678edef3b7bbb","i":"9fbb0d595644b68138f3aafb8310bb94","r":"6081352:6910851:375:3705886","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6081352","6910851","375"],"w":["leaf",1]},{"t":"Te mereces la vida que nunca tuviste.","e":"You deserve the life you never had.","s":"opensubtitles","x":"64dbb9fc9f46f5437d3b4d1cc99ce6cd","i":"b830ddffa88c4151861c488c798b3e91","r":"4966046:7059336:862:3100883","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4966046","7059336","862"],"w":["leaf",1]},{"t":"Es más de lo que te mereces.","e":"It's more than you deserve.","s":"tatoeba","x":"26f8f69b5d3c21249acad172ac247838","i":"ed31c692d0586b99712e59b371089acd","r":"3518992:3518553","c":"teskmon","su":"https://tatoeba.org/en/sentences/show/3518992","ul":"https://tatoeba.org/en/sentences/show/3518992","b":"Tatoeba sentence #3518992 by teskmon; English translation #3518553 by CK","o":"https://tatoeba.org/en/sentences/show/3518992","tu":1,"w":["leaf",1]},{"t":"Tú te mereces una vida mejor.","e":"You deserve a better life.","s":"opensubtitles","x":"0b3e83ecb8029867f1f1cf92885b1326","i":"3dbcd0124fd751c17d223025151ffccd","r":"6140640:6807734:454:2767465","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6140640","6807734","454"],"w":["leaf",1]}]]},"6fd91ae9":{"m":[[{"t":"Yo sé que piensas que no merezco esta oportunidad.","e":"I know that you think I didn't deserve this opportunity.","s":"opensubtitles","x":"fbdab1e7374d43cac481abb65cc90f49","i":"7a69a86e9043582523d9ca71d86742f1","r":"5062218:6581309:694:1408203","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5062218","6581309","694"],"w":["tuple",0]},{"t":"Sólo quiero las respuestas que merezco, nada más.","e":"I only want the answers I deserve, nothing more.","s":"opensubtitles","x":"6aa396e9d91c095872a9eee2a15fbf9a","i":"85de523b27782705e6bce8d12c952ee0","r":"6201812:6820653:203:2804880","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6201812","6820653","203"],"w":["tuple",0]},{"t":"Pero al mismo tiempo, saben que es lo que deseo y merezco.","e":"But at the same time, they know it's what I want and deserve.","s":"opensubtitles","x":"3bfa055edd88f175f85d0827223ed6c4","i":"979b0f51a33ef92d7c0221453cb82f66","r":"3137630:6881383:509:244849","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3137630","6881383","509"],"w":["tuple",0]},{"t":"Chicas, sé que no merezco una segunda oportunidad.","e":"Ladies. I know I don't deserve a second chance.","s":"opensubtitles","x":"c55fb914383c50b95c7921d4ba47266c","i":"e8810c3aa5b7a94e24e9461fcf6cb91a","r":"3951732:6946151:1471:446726","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3951732","6946151","1471"],"w":["tuple",0]},{"t":"Ya estuve casado varias veces, pero ninguna me dio la felicidad que merezco.","e":"I've already gone through several marriages, but none of them gave me the happiness I deserve.","s":"tatoeba","x":"1260de2a07d79a22b68efa510dc7a243","i":"f92a83c6fe8194d27554762a6038c03b","r":"1218323:1218494","c":"alexmarcelo","su":"https://tatoeba.org/en/sentences/show/1218323","ul":"https://tatoeba.org/en/sentences/show/1218323","b":"Tatoeba sentence #1218323 by alexmarcelo; English translation #1218494 by AlanF_US","o":"https://tatoeba.org/en/sentences/show/1218323","tu":1,"w":["tuple",0]},{"t":"Ahora, te pillo en una mentira, ¿y de repente crees que la merezco?","e":"Now, I catch you in a lie and all of a sudden you think I deserve it? You do.","s":"opensubtitles","x":"4353aa75559cb79496dd9bfdccc9dee5","i":"d33270be3b57c10021fe16b056a7e4a4","r":"6626200:6965601:761:4127429","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6626200","6965601","761"],"w":["tuple",0]},{"t":"Exactamente por eso creo que merezco uno.","e":"Which is exactly why I think I deserve one.","s":"opensubtitles","x":"b10e45d17f1b1477f916515a21bb2b9f","i":"1f9596331c37069de2947c20e5988c69","r":"6261064:7004750:6:3884568","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6261064","7004750","6"],"w":["tuple",0]},{"t":"Merezco que se me den las gracias.","e":"I deserve to be thanked.","s":"tatoeba","x":"29485de61de8a791f3d78652e5ebd549","i":"cbaaba7575da8a73767268db1137183e","r":"10268248:10268243","c":"Seael","su":"https://tatoeba.org/en/sentences/show/10268248","ul":"https://tatoeba.org/en/sentences/show/10268248","b":"Tatoeba sentence #10268248 by Seael; English translation #10268243 by samir_t","o":"https://tatoeba.org/en/sentences/show/10268248","tu":1,"w":["tuple",0]}],[{"t":"Quizá no me merezco nada más que exactamente lo que tengo.","e":"Maybe I don't deserve anything more than exactly what I got.","s":"opensubtitles","x":"b67a432c9da2ce5ba25941709290a2c9","i":"46150cde82bfd3aeb1cd25602aac9c92","r":"4549128:6631672:13:784263","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4549128","6631672","13"],"w":["leaf",1]},{"t":"Creo que me merezco algo de pastel.","e":"I think I deserve some pie.","s":"opensubtitles","x":"06cc3e97ee2e50e1b8d5c687811d484b","i":"c866fe1526c4debb657dec8e28f217b5","r":"5669118:6805243:677:2388695","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5669118","6805243","677"],"w":["leaf",1]},{"t":"Me merezco algo peor que eso.","e":"I deserve far worse than that.","s":"opensubtitles","x":"3b652b727ae0970015efa2f4bf3391b9","i":"e73513ed77acaa11159f3b3b960b6dce","r":"5178720:6676357:675:1565861","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5178720","6676357","675"],"w":["leaf",1]},{"t":"No me merezco oír eso.","e":"I don't deserve to hear this.","s":"tatoeba","x":"8c74ea707db5409c8e6e4e3fb880aa50","i":"7db94013d96b361b6891cd75b9557af9","r":"1576664:10367156","c":"Shishir","su":"https://tatoeba.org/en/sentences/show/1576664","ul":"https://tatoeba.org/en/sentences/show/1576664","b":"Tatoeba sentence #1576664 by Shishir; English translation #10367156 by DJ_Saidez","o":"https://tatoeba.org/en/sentences/show/1576664","tu":1,"w":["leaf",1]},{"t":"Pero me merezco una explicación.","e":"But I deserve an explanation.","s":"opensubtitles","x":"9c9ed1ee4050bc9f1b0ec87e08eef6ce","i":"ccb5d800b8c58456b9052db9caffbec2","r":"5983092:6774111:580:2630900","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5983092","6774111","580"],"w":["leaf",1]},{"t":"Porque yo me lo merezco.","e":"Because I deserve it.","s":"tatoeba","x":"94aea44c9a6a579804699d29b24141e7","i":"fcea1f615d4fc5a35f4bf048c67f49ed","r":"8395147:9193484","c":"arh","su":"https://tatoeba.org/en/sentences/show/8395147","ul":"https://tatoeba.org/en/sentences/show/8395147","b":"Tatoeba sentence #8395147 by arh; English translation #9193484 by DJ_Saidez","o":"https://tatoeba.org/en/sentences/show/8395147","tu":1,"w":["leaf",1]},{"t":"Y me lo merezco.","e":"And I deserve it.","s":"opensubtitles","x":"db2901295b7325883ba1b4867f0db02e","i":"0cfeaa13b3c1cdafdf34ef4ce2babc58","r":"5028904:6751716:342:1365690","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5028904","6751716","342"],"w":["leaf",1]},{"t":"No me lo merezco.","e":"I do not deserve it.","s":"tatoeba","x":"86e68b19847f13f67208f329f3670278","i":"386a6504d58c7e8fa0fa49b1c8662481","r":"1195980:914035","c":"Shishir","su":"https://tatoeba.org/en/sentences/show/1195980","ul":"https://tatoeba.org/en/sentences/show/1195980","b":"Tatoeba sentence #1195980 by Shishir; English translation #914035 by Jane_Austen","o":"https://tatoeba.org/en/sentences/show/1195980","tu":1,"w":["leaf",1]}]]},"3bddc92a":{"m":[[{"t":"Una total mentira, pero confía en mí, Blanca se lo merecía.","e":"Total lie, but trust me, Blanca deserved it.","s":"opensubtitles","x":"c4cf19f392a5d599a22d86a9d9b39165","i":"05ba1e813549130d7c5ccbf11d26c405","r":"5502110:6659783:577:2147317","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5502110","6659783","577"],"w":["tuple",0]},{"t":"Una incluso me dijo que yo no merecía estar aquí.","e":"One even told me that I didn't deserve to be here.","s":"opensubtitles","x":"9ba61f09fe8bc484468959b3b4fad2f8","i":"9b39eaca1167624c4a9bb0f6c56a6a53","r":"3951732:6946151:286:445637","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["3951732","6946151","286"],"w":["tuple",0]},{"t":"¿O es que todos piensan que se lo merecía?","e":"Or did you all think he had it coming?","s":"opensubtitles","x":"7b2d687699f3fcf7d9bdab43a89d2b1c","i":"c606fe61cecdbf5b76ab4d6aecd7048e","r":"5002680:6511167:1024:1340825","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5002680","6511167","1024"],"w":["tuple",0]},{"t":"Igual la mía, pero yo como que lo merecía.","e":"So did mine, but I sorta deserved it.","s":"opensubtitles","x":"0427f8f6a4fbd71eed1f59c9748bd9b5","i":"ecffaa4a6e9515506f9726d5b130e50b","r":"6237208:6895556:163:3865847","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6237208","6895556","163"],"w":["tuple",0]},{"t":"Yo creo que no merecía el castigo que obtuve.","e":"I don't think that I deserved the punishment I got.","s":"tatoeba","x":"1be97749e1cc2b75e355fc01fb40cdf3","i":"6c73369e96ac29fc6bfed856193380d8","r":"1305599:953440","c":"marcelostockle","su":"https://tatoeba.org/en/sentences/show/1305599","ul":"https://tatoeba.org/en/sentences/show/1305599","b":"Tatoeba sentence #1305599 by marcelostockle; English translation #953440 by CK","o":"https://tatoeba.org/en/sentences/show/1305599","tu":1,"w":["tuple",0]},{"t":"Bueno, es probable que se lo merecía.","e":"Well, they probably deserved it.","s":"opensubtitles","x":"10ae24d7c5da31b5476eb7d5e08f824f","i":"43de1fc0404df0f259d21a3aebf5a0f3","r":"5222290:6509586:231:1694640","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5222290","6509586","231"],"w":["tuple",0]},{"t":"Probablemente se lo merecía de alguna manera.","e":"She probably deserved it some way anyway.","s":"opensubtitles","x":"27fb0f343bc52ae878fcbf9992c09787","i":"bb3f6a806e9603efaa336b228b4f2c53","r":"5530918:6707361:505:2203122","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5530918","6707361","505"],"w":["tuple",0]}],[{"t":"No se merecía morir a causa de eso.","e":"He didn't deserve to die because of that. No.","s":"opensubtitles","x":"0a979c9120a7842ac46c009c9d554c27","i":"7374b72062b00ffa63778aab2e558e7f","r":"5147706:6551047:348:1512606","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5147706","6551047","348"],"w":["leaf",1]},{"t":"Me has dicho que todo el que fue atacado se merecía ser atacado.","e":"You tell me that everyone that was targeted deserved to be targeted.","s":"opensubtitles","x":"7bf0b81193fb4ee20a9d4987faf24b89","i":"9c6cdf074c571ac5bfdb51943582f279","r":"6102492:6923676:702:2736654","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6102492","6923676","702"],"w":["leaf",1]},{"t":"Esa gente recibió lo que se merecía.","e":"These people got what they deserved.","s":"opensubtitles","x":"b81ce4448e095d5148f0b78a6e256c86","i":"317c7b3c66f3e2d30205a4b4b78a1c26","r":"5207734:6862059:297:1631085","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5207734","6862059","297"],"w":["leaf",1]},{"t":"Se merecía un mejor hijo.","e":"He deserved a better son.","s":"opensubtitles","x":"3611cbb721661f019dbd6df60295ce20","i":"3867c1d3f2e4847514b7e424a689a1b7","r":"5775864:7068555:61:3438023","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5775864","7068555","61"],"w":["leaf",1]},{"t":"Sí, me merecía esa mirada.","e":"Yeah, I deserved that look.","s":"opensubtitles","x":"f7e90b777636ca87d7ded0757bfe97ce","i":"f5babd521a484f212f7048d165d6618f","r":"5963988:6860551:47:2622472","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5963988","6860551","47"],"w":["leaf",1]},{"t":"Tom se merecía el castigo que recibió.","e":"Tom deserved the punishment he got.","s":"tatoeba","x":"c85dd6b69f28d6c14794cdcdd84c6b1f","i":"47efbbdab5b0a9fdf45f6f27a31b9745","r":"3300140:1094885","c":"marcelostockle","su":"https://tatoeba.org/en/sentences/show/3300140","ul":"https://tatoeba.org/en/sentences/show/3300140","b":"Tatoeba sentence #3300140 by marcelostockle; English translation #1094885 by CK","o":"https://tatoeba.org/en/sentences/show/3300140","tu":1,"w":["leaf",1]},{"t":"Tom le dio a Mary más crédito del que se merecía.","e":"Tom gave Mary more credit than she deserved.","s":"tatoeba","x":"1c2b3fd27981cddd5e05276527d47043","i":"fb31b789df3b7fbd4ad6b122e497c111","r":"1634665:1094020","c":"marcelostockle","su":"https://tatoeba.org/en/sentences/show/1634665","ul":"https://tatoeba.org/en/sentences/show/1634665","b":"Tatoeba sentence #1634665 by marcelostockle; English translation #1094020 by CK","o":"https://tatoeba.org/en/sentences/show/1634665","tu":1,"w":["leaf",1]}]]},"dc19f1dc":{"m":[[{"t":"No merecen comenzar de nuevo, y no se los permitiré.","e":"They don't deserve to start again, and I'm not going to let them.","s":"opensubtitles","x":"69494c65dfdcd2eca6ab1143f0b116d5","i":"575d543ef3f06579c486bd272d4331c7","r":"2316204:7058191:1164:2914759","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["2316204","7058191","1164"],"w":["tuple",0]},{"t":"Merecen salir de aquí con toda la ayuda que puedan obtener.","e":"They deserve to leave here with all the help they can get.","s":"opensubtitles","x":"b65908655e76b0178d95079b868e1f38","i":"ca656c2af9d599e5451da1f860e9e1eb","r":"4659056:7009354:148:906853","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4659056","7009354","148"],"w":["tuple",0]},{"t":"Las ideas no merecen tal destino, no en mi opinión.","e":"Ideas do not merit such a fate, not in my opinion.","s":"opensubtitles","x":"16f9406b8a027a7a151be2b41c7bda60","i":"dbc705ca268feaf7add3ce5233575b83","r":"4844246:6519965:824:1131340","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4844246","6519965","824"],"w":["tuple",0]},{"t":"¡La muerte de mi hermana destruyó mi familia y ellos merecen ser castigados!","e":"My sister's death destroyed my family and they deserve to be punished!","s":"opensubtitles","x":"9a5806686caff132e666aab7be473d81","i":"4993a747f864da3fa73de36de9588ea1","r":"5317460:6959755:4:1889262","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5317460","6959755","4"],"w":["tuple",0]},{"t":"Seguramente me estoy recibiendo lo que merecen.","e":"I'm probably just getting what I deserve.","s":"opensubtitles","x":"339d8059159655633f25aa12ed23e750","i":"1b10c4579ff9fae9e467c21a7ec35b25","r":"4574802:6596074:699:821568","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4574802","6596074","699"],"w":["tuple",0]},{"t":"Hay oraciones que merecen no ser traducidas.","e":"There are sentences which do not deserve to be translated.","s":"tatoeba","x":"c40926fd061225b4ad7bda8b72cc0a7b","i":"05a6f8