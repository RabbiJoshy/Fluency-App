36647:620:1083987","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4800062","6736647","620"],"w":["tuple",0]},{"t":"Ya has hablado suficiente sobre este tema, así que puedes callarte la boca.","e":"You've said enough on this topic, so you can shut your mouth.","s":"opensubtitles","x":"3ac16421fc3912db6f1b2193bace5fac","i":"af381457f516172db73d5e69df3762c1","r":"5563364:6874699:320:3263839","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5563364","6874699","320"],"w":["tuple",0]},{"t":"Si eso fuese verdad, deberías callarte.","e":"If that were true, then you would shut up.","s":"opensubtitles","x":"872d5fbbe84b3b05d0f88a02894f0ab0","i":"09059ceed7148e31de8a847349a546fd","r":"4857194:6552249:127:1150608","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4857194","6552249","127"],"w":["tuple",0]},{"t":"¿Podrías callarte para que podamos dormir?","e":"Will you just shut up so we can go to sleep?","s":"opensubtitles","x":"ab98f8dde221e268458b0fb03b27e5df","i":"2353d8c25f219a63beb9b1a1014df500","r":"6141526:7067253:67:3754046","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6141526","7067253","67"],"w":["tuple",0]},{"t":"¿Podrías callarte un momento, por favor?","e":"Will you shut up for a minute, please?","s":"opensubtitles","x":"fe2b5415b8f8d6de8c523ea384d158a4","i":"6be64f73c24811d4d8827c6a92a45c47","r":"5753452:6809197:404:2470214","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5753452","6809197","404"],"w":["tuple",0]},{"t":"Y ahora ¿quieres callarte, por favor?","e":"Now, would you please shut up?","s":"opensubtitles","x":"8282bb217f1bbe0f967328c077782af4","i":"dddaf8bdc6342239bb0962ddcab675d0","r":"5320642:6829709:614:1893234","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5320642","6829709","614"],"w":["tuple",0]},{"t":"¿Quieres abrir eso y callarte ya?","e":"- Would you just open it and shut up already?","s":"opensubtitles","x":"a2978c13f0700df4e479791412312e39","i":"ec7456c756fe700187c19739b600fbe6","r":"4559