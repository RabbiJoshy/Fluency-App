d832b8a64849","r":"5989600:6875888:651:3634612","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5989600","6875888","651"],"w":["tuple",0]},{"t":"Estamos averiguar el mejor recurso ... y eso significa retroceder en el.","e":"We're just figuring out the best recourse... and that means going back in.","s":"opensubtitles","x":"f98b3522edcbf41272a373062bb8744f","i":"7ceb7adb9ca241109098a085a22712c4","r":"5752198:6848580:593:3421737","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5752198","6848580","593"],"w":["tuple",0]},{"t":"Creo que deberíamos retroceder a la carretera un par de millas, llevarlos allí.","e":"I think we should go back up the road a couple miles, take them there.","s":"opensubtitles","x":"f0d1c7e63a6930be2a4f4d430a4abfb6","i":"902d504bf3d37da987df7316a346fd99","r":"5679402:6788258:762:2396151","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5679402","6788258","762"],"w":["tuple",0]},{"t":"Vamos a retroceder un segundo, ¿de acuerdo?","e":"Let's just step back a second, alright?","s":"opensubtitles","x":"2f5d3ebc909cb358070a7a3216635d64","i":"80aeed5f433e54a72d2f506578b23727","r":"1718924:7053919:623:70415","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1718924","7053919","623"],"w":["tuple",0]},{"t":"Es muy tarde para retroceder ahora.","e":"It's too late to turn back now.","s":"tatoeba","x":"f6da2cebddd07fb15113c9838c9e05a3","i":"30f441a29950cabdb2d9fb7b3b00a919","r":"855313:65878","c":"Crul","su":"https://tatoeba.org/en/sentences/show/855313","ul":"https://tatoeba.org/en/sentences/show/855313","b":"Tatoeba sentence #855313 by Crul; English translation #65878 by CK","o":"https://tatoeba.org/en/sentences/show/855313","tu":1,"w":["tuple",0]},{"t":"Tuviste la oportunidad de retroceder ayer.","e":"You had the chance to back out yesterday.","s":"opensubtitles","x":"7c272da32f47fed09954cacd9eba55eb","i":"68896044c49ad663f00cb7a4c990bf92","r":"4805316:6963727:257:1085048","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4805316","6963727","257"],"w":["tuple",0]},{"t":"Quizás quieras retroceder unos pasos, amor.","e":"You'll probably want to take a few steps back, amor.","s":"opensubtitles","x":"257b59d7e78c4f54310603c8aa748d7f","i":"e1b276eb9fd6d8cc45fd02e739629ed5","r":"4862548:6623898:380:1170326","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4862548","6623898","380"],"w":["tuple",0]},{"t":"Necesito hacerlo retroceder, pero no soy buena en eso. Sí.","e":"I need to push it back but I'm not good at that.","s":"opensubtitles","x":"51be8719b24f009edadf9b5c86f1032e","i":"7e11294860b140395aecdb04819368a1","r":"4399590:6853378:692 693:664903","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4399590","6853378","692 693"],"w":["tuple",0]},{"t":"Sí, sí, claro. Tenemos que retroceder, así que espera.","e":"Yeah, yeah, sure, we have to backtrack, so hold on.","s":"opensubtitles","x":"c5d25e1a3928baf2d5a6866f3ff0e988","i":"151e89962d044a31624ffd8025e496c8","r":"5068650:6956935:816 817:3110463","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5068650","6956935","816 817"],"w":["tuple",0]},{"t":"Sabes, en verdad necesitas retroceder.","e":"You know, you really need to back off.","s":"opensubtitles","x":"1d5c2a0803eeaca900df14d1491e59a8","i":"250c147222d14515f0753e8f84cd16e5","r":"5351000:6488103:984:1973288","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5351000","6488103","984"],"w":["tuple",0]}],[{"t":"Podría retroceder y cambiar la historia él mismo.","e":"He could just go back and change history himself.","s":"opensubtitles","x":"80bf94c6bbfcd5e09971b1641498e73a","i":"4142541d0a3035131624fd574cac79c6","r":"5957752:6879171:12:3599565","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5957752","6879171","12"],"w":["tuple",0]},{"t":"Entonces si pudiera retroceder y hacerlo todo de nuevo, lo haría de una forma muy diferente.","e":"Then if I could go back and do it all again, I would do it all so differently.","s":"opensubtitles","x":"4b7dfe0b64872400bc9a0be688a588a7","i":"0bc97b862f7ea430bd6ac552b8aced93","r":"6132414:6769585:602:2752427","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6132414","6769585","602"],"w":["tuple",0]}],[{"t":"No puedo retroceder las cosas que he hecho.","e":"I can't take back the stuff that I've done.","s":"opensubtitles","x":"2b2999594c24f2aa9d413c073ac1c95c","i":"d32987abdc590b48c5d451ae7811fb89","r":"6190642:6911614:729:3812952","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6190642","6911614","729"],"w":["tuple",0]},{"t":"Si haces estos rituales, puedes hacer retroceder el tiempo.","e":"If you do these rituals, you can make time go backwards.","s":"opensubtitles","x":"0394b36267c5ed61bdf9798d05d13711","i":"655dca17aa0508f79adbbcf49887ea59","r":"4976144:6701489:244:1319690","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4976144","6701489","244"],"w":["tuple",0]},{"t":"A veces, en la vida queremos avanzar pero hay algo que nos hace retroceder.","e":"Sometimes in life... we're wanting to make steps forward but there seems to be something pulling us back.","s":"opensubtitles","x":"79c87be14a52ff6843d5c5b11b79f834","i":"8421c80c393f510aca477c2a32bd40e9","r":"5151716:6693565:1806:1522085","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5151716","6693565","1806"],"w":["tuple",0]},{"t":"Tenemos que retroceder en el tiempo.","e":"We need to go back in time.","s":"opensubtitles","x":"b5bf296c88052e28ac593721c9a0118e","i":"0e2f42e0024755b3439a722e07d52c1f","r":"5540400:6891905:707:2224976","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5540400","6891905","707"],"w":["tuple",0]}],[{"t":"De uno u otro modo, sabías que no podías retroceder.","e":"I mean, either way, you knew you couldn't back down.","s":"opensubtitles","x":"093e332982b0331138c01320dfa2fd88","i":"6da68f6cd9d2a9e098c0d46f9716cf12","r":"5002648:6497534:891:1339665","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5002648","6497534","891"],"w":["tuple",0]}],[]]},"12f48bd1