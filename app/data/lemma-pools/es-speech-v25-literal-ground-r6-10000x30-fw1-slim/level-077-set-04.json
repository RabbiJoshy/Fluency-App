.php","d":["5957854","6911998","365"],"w":["tuple",0]},{"t":"- O su matón, de cualquier manera.","e":"- Or his hit man anyway.","s":"opensubtitles","x":"910701ad7b4fa38a48dadcd87df61255","i":"64de4fbc5b424fd1124c0940eb187a66","r":"5668562:6833068:635:2379752","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5668562","6833068","635"],"w":["tuple",0]},{"t":"Dijo que hizo amenazas y contrató a un matón para tomar su nariz fuera de servicio.","e":"Said you made threats and hired a thug to take his nose out of commission.","s":"opensubtitles","x":"dfbecc36f802543cea35944374ce5836","i":"9c1f3a25215cd0c9aea9b8faa1fc9b3f","r":"5197264:6463094:524:1601657","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5197264","6463094","524"],"w":["tuple",0]},{"t":"Se presentó con un matón.","e":"He showed up with some thug.","s":"opensubtitles","x":"e6adaa2daa95488d70324bd44bcb03fa","i":"54bbd12a91d73ce0e83ce95106b61298","r":"5494562:7019697:261:2140085","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5494562","7019697","261"],"w":["tuple",0]},{"t":"¿A quién le dice matón?","e":"Who are you calling a thug?","s":"opensubtitles","x":"c70465c21e36621e3396541b240033a3","i":"6581f9c2eba1718e80a31c082fb726f2","r":"5243942:6536257:745:1754752","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5243942","6536257","745"],"w":["tuple",0]},{"t":"Eres un terrorista, un matón.","e":"You're a terrorist, a thug.","s":"opensubtitles","x":"98958940196270e16a713d892e85b4ed","i":"f35ef88a659f6785deca6538b1eb548a","r":"5916840:6954106:638:3569110","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5916840","6954106","638"],"w":["tuple",0]},{"t":"No es un matón.","e":"He's no thug.","s":"opensubtitles","x":"ce27f1009d16c9044d80739b0a9b91fd","i":"72d84f7ad2a81728ff2629c7a988c844","r":"5317574:6491641:340:1890147","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5317574","6491641","340"],"w":["tuple",0]}],[{"t":"No me hagas sonar como un matón que te hace callar.",