{"rule":"lemma-pool/v1","groups":{"sangrar":{"host":"1795a61d","siblings":["763532d0"]}},"rows":{"763532d0":{"word":"sangrar","rank":9750,"meanings":[{"headword":"sangrar","pos":"VERB","source_reference":"spanishdict-menu:sangrar:2d1","translation":"to bleed","context":"to lose blood"},{"headword":"sangrar","pos":"VERB","source_reference":"spanishdict-menu:sangrar:2d1c","translation":"to bleed","context":"to make bleed"}]}},"examples":{"763532d0":{"m":[[{"t":"Bueno, ya debería haber dejado de sangrar en este momento.","e":"Well, that should have stopped bleeding by now.","s":"opensubtitles","x":"07d5433453d6c0587f70d78c7515b428","i":"03330c2f96a6b142a48eb1e2cd07fce2","r":"5584096:6770485:410:2282067","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5584096","6770485","410"],"w":["leaf",1]},{"t":"La paciente y el bebé podrían sangrar hasta morir.","e":"The patient and the baby both could bleed to death.","s":"opensubtitles","x":"22c42d144ad389670a992f0b502e9299","i":"252471b32e37e09e014f6cbdc49988d8","r":"5467378:6584979:296:2099514","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5467378","6584979","296"],"w":["leaf",1]},{"t":"Usted no tiene cuidado, que van a sangrar seco.","e":"You ain't careful, they're gonna bleed you dry.","s":"opensubtitles","x":"af44f3409d6b8bd0afe712668c5c124f","i":"4147779379bddbb2c9909486aeb5fc3d","r":"4114526:6475094:181:498602","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4114526","6475094","181"],"w":["leaf",1]},{"t":"Es para que los malos no me vean sangrar.","e":"Well, that's so bad guys can't see me bleed.","s":"opensubtitles","x":"06c85c7e62f91dea5daa2480d92f9f16","i":"7b57a52cab6822bdcc1edb2f0827aa4f","r":"1431045:6871413:127:25784","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["1431045","6871413","127"],"w":["glosskey",0]},{"t":"Tu hígado puede empezar a sangrar de nuevo.","e":"Your liver could start bleeding again.","s":"opensubtitles","x":"708321afc5c1648d32a9c65b9a9ea735","i":"9572d98550adc1c1bc7f7e99bd39e345","r":"6215184:7004297:542:3848228","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6215184","7004297","542"],"w":["glosskey",0]},{"t":"¿Quién diablos necesita un arma cuando solo hace falta sangrar sobre ella?","e":"Well, who the hell needs a gun when all it takes is you bleeding on her?","s":"opensubtitles","x":"12c3ce4f40514be09b525c25556bb9ee","i":"e37a2cd65dd29028dcdbc827ba371eb3","r":"5926362:6946978:83:3573296","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5926362","6946978","83"],"w":["glosskey",0]},{"t":"Me rasqué la cabeza tanto que me comenzó a sangrar.","e":"I scratched my head so hard it started bleeding.","s":"tatoeba","x":"fcf9ec8ce604a97167cd774429dd5cd9","i":"0417aa7e704e0359034f09f75a8dfade","r":"10004457:10004449","c":"arh","su":"https://tatoeba.org/en/sentences/show/10004457","ul":"https://tatoeba.org/en/sentences/show/10004457","b":"Tatoeba sentence #10004457 by arh; English translation #10004449 by DJ_Saidez","o":"https://tatoeba.org/en/sentences/show/10004457","tu":1,"w":["glosskey",0]},{"t":"No a menos que cuentes sangrar por cada maldito agujero de mi cuerpo.","e":"Not unless you count bleeding out of every damn hole in my body.","s":"opensubtitles","x":"a47b5cb92f170faa3b93455307b12e12","i":"e45d0a2e1b2bc4b417711e942ad88b57","r":"5580076:6690178:417:2270974","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5580076","6690178","417"],"w":["glosskey",0]},{"t":"Sí, pero vas a sangrar hasta morir.","e":"- Yeah, but you're gonna bleed to death.","s":"opensubtitles","x":"e96c6a95ef2c65ecda606442c2dd3d25","i":"755cbe040899ef33406b9b4c4894bbe0","r":"5843670:6901818:273:2539638","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5843670","6901818","273"],"w":["leaf",1]},{"t":"Él va a sangrar hasta la muerte.","e":"He'll bleed to death.","s":"opensubtitles","x":"a17ccc9000ae99d5f6a7c8cdf4972b2f","i":"8b3dd55df196a225436498e8c226ee25","r":"4648546:6534781:914:893558","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4648546","6534781","914"],"w":["leaf",1]},{"t":"No me dejan de sangrar las encías.","e":"My gums won't stop bleeding.","s":"tatoeba","x":"27795a7da555c2c3a790da8108aa5eae","i":"1fff6e137c3539cc9f82e046905dd4e9","r":"11728559:3670798","c":"Seael","su":"https://tatoeba.org/en/sentences/show/11728559","ul":"https://tatoeba.org/en/sentences/show/11728559","b":"Tatoeba sentence #11728559 by Seael; English translation #3670798 by mervert1","o":"https://tatoeba.org/en/sentences/show/11728559","tu":1,"w":["leaf",1]},{"t":"El alfiler perforó su dedo y se empezó a sangrar.","e":"The pin pierced his finger and it began to bleed.","s":"tatoeba","x":"fa96f9907d2ec9e02f06ff8e83f944af","i":"a4568011d107748622e70af1f5e02ec9","r":"1313770:34445","c":"marcelostockle","su":"https://tatoeba.org/en/sentences/show/1313770","ul":"https://tatoeba.org/en/sentences/show/1313770","b":"Tatoeba sentence #1313770 by marcelostockle; English translation #34445 by Swift","o":"https://tatoeba.org/en/sentences/show/1313770","tu":1,"w":["glosskey",0]},{"t":"¿Qué pasa con el hígado sangrar?","e":"What about the liver bleed?","s":"opensubtitles","x":"47778ae2fd26fdbc9c35149d4fc06e31","i":"3bd50a1d01b8361df48e080b38f97c67","r":"5232810:6450177:503:1716940","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5232810","6450177","503"],"w":["leaf",1]},{"t":"Mi nariz empezó a sangrar literalmente.","e":"My nose literally started bleeding.","s":"opensubtitles","x":"fa39d9f67a5c84ebcf2cf7e941d23688","i":"e6c9a83acd4edc7582d19f29668bbcc1","r":"4976372:6477752:161:1320270","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4976372","6477752","161"],"w":["leaf",1]},{"t":"La herida no para de sangrar.","e":"The wound will not stop bleeding.","s":"tatoeba","x":"d62f7a863a6ff908c744a0f5ba96490f","i":"efb420150efc77bc7d4a6ef9f4359852","r":"5011606:8566219","c":"don_ramon","su":"https://tatoeba.org/en/sentences/show/5011606","ul":"https://tatoeba.org/en/sentences/show/5011606","b":"Tatoeba sentence #5011606 by don_ramon; English translation #8566219 by guavalava","o":"https://tatoeba.org/en/sentences/show/5011606","tu":1,"w":["leaf",1]},{"t":"Ha tenido un accidente de coche, dijo que estaba bien y entonces empezó a sangrar.","e":"What happened? She was in a car accident and she said she was fine and then she started bleeding.","s":"opensubtitles","x":"50ece174308d9db03c5fee14a009ba3b","i":"008d9a281a6b18512b647357f31fd7ab","r":"5182088:6591999:139:1576211","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5182088","6591999","139"],"w":["leaf",1]},{"t":"No ha dejado de sangrar.","e":"She hasn't stopped bleeding.","s":"opensubtitles","x":"ffe11dfee33f925a066823dfa428d538","i":"363cbec4102a10cf2e2aef514c1b8f5f","r":"5505676:6591808:242:2164411","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5505676","6591808","242"],"w":["leaf",1]},{"t":"Quizá simplemente dejó de sangrar.","e":"Uh, maybe he just stopped bleeding.","s":"opensubtitles","x":"f8bcd7b82c348d68fd55798119192cbe","i":"4232da2bda602c5c2a2d263b823f944a","r":"5535206:7068156:180:3243623","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5535206","7068156","180"],"w":["leaf",1]},{"t":"Esto puede sangrar un poco.","e":"This may bleed a bit.","s":"opensubtitles","x":"24a6c65f67cb7d4000f028edb3db9183","i":"72bcdfbbb98af95b7964b786819f0a6d","r":"4655800:6994838:559:905309","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4655800","6994838","559"],"w":["glosskey",0]},{"t":"La herida comenzó a sangrar.","e":"The wound started to bleed.","s":"tatoeba","x":"b10dfb4230dba6d680d70bf06be858a2","i":"8ff45c61342f76f702ae3229c4c9c2ed","r":"2025494:2753625","c":"marcelostockle","su":"https://tatoeba.org/en/sentences/show/2025494","ul":"https://tatoeba.org/en/sentences/show/2025494","b":"Tatoeba sentence #2025494 by marcelostockle; English translation #2753625 by MarijnKp","o":"https://tatoeba.org/en/sentences/show/2025494","tu":1,"w":["leaf",1]},{"t":"Listos para sangrar, ¿no?","e":"Prepared to bleed, are ye?","s":"opensubtitles","x":"997802d6a8ddd257ae6b503f972b60eb","i":"5ab59a8f6b0fa8c4d6408b1d1e7c844d","r":"4462718:6738440:427:722663","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4462718","6738440","427"],"w":["glosskey",0]},{"t":"- ¡No podemos sangrar aquí!","e":"- We can't bleed in here!","s":"opensubtitles","x":"612f8de2e229267b9de7bb2e67ed8f08","i":"88ee9b1dd9d6882037f573936cb66dcf","r":"5946792:7008502:466:3592593","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5946792","7008502","466"],"w":["leaf",1]},{"t":"No... ¡No deja de sangrar!","e":"It doesn't... It won't stop bleeding!","s":"opensubtitles","x":"f0e5f80483016a9ff706eca497522308","i":"112d76b22ecd41c4756b2f8b34787c89","r":"6217010:7047192:529:3850730","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6217010","7047192","529"],"w":["leaf",1]}],[]]}}}