d628d902d0bc672d6","r":"5709242:7007924:690:2423665","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5709242","7007924","690"],"w":["tuple",0]},{"t":"No te enojes tanto.","e":"Don't be so angry.","s":"tatoeba","x":"7d2afe5fbabedb493f5922ebc8e5dd7d","i":"9a4c4b17c661449fbe4fa250fcb15664","r":"10596539:41478","c":"DJ_Saidez","su":"https://tatoeba.org/en/sentences/show/10596539","ul":"https://tatoeba.org/en/sentences/show/10596539","b":"Tatoeba sentence #10596539 by DJ_Saidez; English translation #41478 by CK","o":"https://tatoeba.org/en/sentences/show/10596539","tu":1,"w":["tuple",0]}],[{"t":"Mamá, no te enojes, pero estoy en la comisaría.","e":"Mom, don't get mad, but I'm at the police station.","s":"opensubtitles","x":"f9f9eea2bd2bf7f5d91f4ffe1057148a","i":"1459fc227dd23f36b6b9307630db8568","r":"6117556:7001848:307:2747948","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6117556","7001848","307"],"w":["tuple",0]},{"t":"Tomé una decisión y no quiero que te enojes.","e":"I've made a decision, and I don't want you to get mad.","s":"opensubtitles","x":"e9738f1c26c0555ebc4687c3bb23ee13","i":"2f34087caa6be8d3b16e20e04c5c1fb8","r":"4998158:6556331:283:1332677","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4998158","6556331","283"],"w":["tuple",0]},{"t":"Oye, no te enojes conmigo, ¿de acuerdo?","e":"Hey, don't get mad at me, okay?","s":"opensubtitles","x":"e7b8df9a7187262cbbb126817e94245f","i":"ea96c14dfb67cab9811c4b11c30cb17d","r":"5602008:6592717:183:2320067","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5602008","6592717","183"],"w":["tuple",0]},{"t":"No te enojes con el mensajero.","e":"Hey, don't get mad at the messenger.","s":"opensubtitles","x":"896d7167427a49f3da54d251a9aa447c","i":"df84c40004bd1bb2c88cbbfbfed2d81e","r":"4608882:6819753:57:845136","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4608882","6819753","57"],"w":["tuple",0]},{"t":"Solo, uh, No te enojes conmigo.","e":"Just, uh, don't ever get mad at me.","s":"opensubtitles","x":"35730dc8d189ad8945c4725561ca5983","i":"1bd8970c7a14dac1126f3179e374bb29","r":"6106708:6905702:633:3728238","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6106708","6905702","633"],"w":["tuple",0]},{"t":"Necesitamos que te enojes.","e":"We need you to get mad. No.","s":"opensubtitles","x":"9afdf5b55172ada9a77d06375061addf","i":"0d8ccd5136fc7333ffb8fdda7d6f736d","r":"4741656:6591515:197:1024362","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["4741656","6591515","197"],"w":["tuple",0]}]]}}}