b78a786239faecd1b7","r":"5223564:6501057:19:1704594","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5223564","6501057","19"],"w":["tuple",0]},{"t":"No tuviste miedo de perseguir la verdad, sin importar el riesgo.","e":"You weren't afraid to pursue the truth, no matter what the risk.","s":"opensubtitles","x":"a58d17cb3e34b3a7b7b69abbeef073cb","i":"77ed8be8e6e24838e2b5176282d18fbc","r":"5957876:6961041:789:3608371","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5957876","6961041","789"],"w":["tuple",0]},{"t":"Y tú tienes que dejar de perseguir niñas y trabajar en tu música.","e":"And you need to stop chasing kids and actually work on your music.","s":"opensubtitles","x":"1882d6d9d0af36d9ab5a0ad73cc0abf4","i":"de1842d956de37dc377ed9e43c4047f5","r":"6338080:6994113:658:3941736","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6338080","6994113","658"],"w":["tuple",0]},{"t":"Eso explica por qué la víctima dejó de perseguir a Leah Marino.","e":"That explains why the victim stopped targeting Leah Marino.","s":"opensubtitles","x":"c67fcb58d9770ce10909129eacfd8e55","i":"4e41fc8511bfdc9f633c4797df5976e7","r":"5323696:6953478:565:1898018","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["5323696","6953478","565"],"w":["tuple",0]},{"t":"¿Quién tiene tiempo para perseguir una pasión?","e":"Who has time to pursue a passion?","s":"opensubtitles","x":"b11f1168d14e46bf3c4d7e3f8d269a76","i":"0d310a93db70998b274625ce6e679ee4","r":"6364948:7001857:325:3963912","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6364948","7001857","325"],"w":["tuple",0]},{"t":"¿Perseguir al científico más famoso del mundo?","e":"Going after the worlds most famous scientist?","s":"opensubtitles","x":"4ceab02ecb09f5774ad4ad63e4d471e6","i":"57e5b54a0fc94595f232e40ce1cf4271","r":"6023836:7036326:161:3673708","su":"http://opus.nlpl.eu/OpenSubtitles-v2018.php","d":["6023836","7036326","161"],"w":["tuple",0]},{"t":"No lo voy a perseguir.","e":"I'm not going after him.","